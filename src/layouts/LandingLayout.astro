---
import BaseLayout from "./BaseLayout.astro";

import { PublicHeader } from "../components/pages/public/PublicHeader";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const { title, description, ogImage, noIndex } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  noIndex={noIndex}
>
  <div class="flex flex-col min-h-screen">
    <PublicHeader client:load />

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border/40 bg-card/30">
      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-8 md:pt-24 md:pb-12"
      >
        <div
          class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-5 gap-12 md:gap-8 mb-16"
        >
          <!-- Brand Column -->
          <div class="md:col-span-1 lg:col-span-2">
            <a href="/" class="flex items-center gap-2 mb-6">
              <div class="bg-primary/10 text-primary p-1.5 rounded-md">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path
                    d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
                  ></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"
                  ></polyline><line x1="12" y1="22.08" x2="12" y2="12"
                  ></line></svg
                >
              </div>
              <span
                class="font-extrabold text-xl tracking-tight text-foreground"
                >Showcrate</span
              >
            </a>
            <p
              class="text-muted-foreground text-sm leading-relaxed max-w-xs mb-8"
            >
              The fastest way to build, deploy, and share live interactive
              documentation environments directly in the browser.
            </p>
            <div class="flex items-center gap-4 text-muted-foreground">
              <!-- Social Icons (GitHub, Discord, Instagram) -->
              <a
                href="https://github.com"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-primary hover:-translate-y-1 transition-all"
                aria-label="GitHub"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path
                    d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                  ></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg
                >
              </a>
              <a
                href="https://discord.com"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-primary hover:-translate-y-1 transition-all"
                aria-label="Discord"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  stroke="none"
                  ><path
                    d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.445.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.618-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.1 18.058a.082.082 0 0 0 .031.056a19.908 19.908 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .078-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.095 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.095 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"
                  ></path></svg
                >
              </a>
              <a
                href="https://instagram.com"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-primary hover:-translate-y-1 transition-all"
                aria-label="Instagram"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect width="20" height="20" x="2" y="2" rx="5" ry="5"
                  ></rect><path
                    d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                  ></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"
                  ></line></svg
                >
              </a>
            </div>
          </div>

          <!-- Links Columns -->
          <div>
            <h3 class="font-semibold text-foreground mb-4">Product</h3>
            <ul class="space-y-3">
              <li>
                <a
                  href="/features"
                  class="text-sm text-muted-foreground hover:text-primary transition-colors"
                  >Features</a>
              </li>
              <li>
                <a
                  href="/pricing"
                  class="text-sm text-muted-foreground hover:text-primary transition-colors"
                  >Pricing</a>
              </li>
              <li>
                <a
                  href="/showcase"
                  class="text-sm text-muted-foreground hover:text-primary transition-colors"
                  >Showcase</a>
              </li>
              <li>
                <a
                  href="/changelog"
                  class="text-sm text-muted-foreground hover:text-primary transition-colors"
                  >Changelog</a>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-foreground mb-4">Resources</h3>
            <ul class="space-y-3">
              <li>
                <a
                  href="/docs"
                  class="text-sm text-muted-foreground hover:text-primary transition-colors"
                  >Documentation</a>
              </li>
              <li>
                <a
                  href="/blog"
                  class="text-sm text-muted-foreground hover:text-primary transition-colors"
                  >Blog</a>
              </li>
              <li>
                <a
                  href="/guides"
                  class="text-sm text-muted-foreground hover:text-primary transition-colors"
                  >Guides</a>
              </li>
              <li>
                <a
                  href="/community"
                  class="text-sm text-muted-foreground hover:text-primary transition-colors"
                  >Community</a>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-foreground mb-4">Legal</h3>
            <ul class="space-y-3">
              <li>
                <a
                  href="/terms"
                  class="text-sm text-muted-foreground hover:text-primary transition-colors"
                  >Terms of Service</a>
              </li>
              <li>
                <a
                  href="/privacy"
                  class="text-sm text-muted-foreground hover:text-primary transition-colors"
                  >Privacy Policy</a>
              </li>
              <li>
                <a
                  href="/security"
                  class="text-sm text-muted-foreground hover:text-primary transition-colors"
                  >Security</a>
              </li>
              <li>
                <a
                  href="/contact"
                  class="text-sm text-muted-foreground hover:text-primary transition-colors"
                  >Contact Us</a>
              </li>
            </ul>
          </div>
        </div>

        <div
          class="border-t border-border/40 pt-8 flex flex-col md:flex-row items-center justify-between gap-4"
        >
          <p class="text-center md:text-left text-sm text-muted-foreground">
            &copy; {new Date().getFullYear()} Showcrate. All rights reserved.
          </p>
          <div class="flex items-center gap-2 text-sm text-muted-foreground">
            <span class="inline-flex h-2 w-2 rounded-full bg-success"></span>
            All systems operational
          </div>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>
