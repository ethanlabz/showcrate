---
import BaseLayout from "./BaseLayout.astro";

import { Button } from "@/components/ui/button";

export interface Props {
  title: string;
  description?: string;
  noIndex?: boolean;
}

const { title, description, noIndex = true } = Astro.props;
const resolvedProject = Astro.locals.project;
const project = resolvedProject?.project;
const owner = resolvedProject?.owner;
---

<BaseLayout
  title={title}
  description={description}
  noIndex={noIndex}
>
  <div class="flex h-screen w-screen flex-col overflow-hidden bg-background text-foreground">
    {/* Editor Chrome Topbar */}
    <header class="flex h-12 shrink-0 items-center justify-between border-b bg-background px-4">
      <div class="flex items-center gap-2 sm:gap-4">
        <a href={project && owner ? `/${owner.username}/${project.slug}` : "/dashboard"} class="flex items-center gap-2 hover:opacity-80 transition-opacity">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" class="h-5 w-5"><rect width="256" height="256" fill="none"></rect><line x1="208" y1="128" x2="128" y2="208" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"></line><line x1="192" y1="40" x2="40" y2="192" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"></line></svg>
        </a>
        <div class="h-4 w-[1px] bg-border mx-1"></div>
        <div class="flex flex-col min-w-0">
          <div class="text-xs text-muted-foreground flex items-center gap-1">
            {project && owner ? (
              <>
                <span class="hover:text-foreground cursor-pointer transition-colors hidden sm:inline-block">{owner.username}</span>
                <span class="hidden sm:inline-block">/</span>
                <span class="font-medium text-foreground hover:underline cursor-pointer truncate max-w-[120px] sm:max-w-none">{project.name}</span>
              </>
            ) : (
              <span class="font-medium text-foreground truncate max-w-[120px] sm:max-w-none">Untitled Project</span>
            )}
          </div>
        </div>
      </div>
      
      <div class="flex items-center gap-2 sm:gap-4 shrink-0">
        {/* Save Status Indicator */}
        <div class="flex items-center gap-2 text-xs text-muted-foreground mr-1 sm:mr-0">
          <div class="h-2 w-2 rounded-full bg-green-500"></div>
          <span class="hidden sm:inline-block">Saved</span>
        </div>
        
        <div class="flex items-center gap-2">
          <Button variant="outline" size="sm" className="h-8 px-2 sm:px-3">
            <span class="hidden sm:inline-block">Preview</span>
            <span class="sm:hidden">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            </span>
          </Button>
          <Button size="sm" className="h-8 px-2 sm:px-3">Publish</Button>
        </div>
      </div>
    </header>

    {/* Main Editor Island Container */}
    <main class="flex-1 overflow-hidden relative">
      <slot />
    </main>
  </div>
</BaseLayout>