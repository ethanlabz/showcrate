---
// src/layouts/EditorLayout.astro
// Standalone editor layout: sibling of AppLayout under BaseLayout
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description?: string;
  noIndex?: boolean;
}

const { title, description, noIndex = true } = Astro.props;
---

<BaseLayout title={title} description={description} noIndex={noIndex}>
  <div class="h-screen w-screen overflow-hidden bg-[#14161B] text-foreground font-sans flex flex-col">
    <slot />
  </div>
</BaseLayout>
