---
// src/layouts/Docs.astro
import BaseLayout from './BaseLayout.astro';
import {
  BookOpen,
  ChevronRight,
  Folder,
  ArrowLeft,
  ArrowRight,
  Menu,
} from 'lucide-react';

export interface DocTreeNode {
  id: string;
  parent_id: string | null;
  kind: 'page' | 'folder';
  title: string;
  slug: string | null;
  order_index: number;
  is_index: boolean;
  children?: DocTreeNode[];
}

export interface Props {
  project: {
    id: string;
    name: string;
    slug: string;
    published?: boolean;
  };
  owner: {
    username: string;
    displayName?: string | null;
  };
  currentPage: {
    id: string;
    title: string;
    slug: string | null;
    is_index: boolean;
  };
  treeNodes: DocTreeNode[];
  isOwner?: boolean;
}

const { project, owner, currentPage, treeNodes, isOwner = false } = Astro.props;

// Build hierarchical tree
function buildTree(nodes: DocTreeNode[]): DocTreeNode[] {
  const map = new Map<string, DocTreeNode>();
  const roots: DocTreeNode[] = [];

  for (const n of nodes) {
    map.set(n.id, { ...n, children: [] });
  }

  for (const n of nodes) {
    const item = map.get(n.id)!;
    if (n.parent_id && map.has(n.parent_id)) {
      map.get(n.parent_id)!.children!.push(item);
    } else {
      roots.push(item);
    }
  }

  const sortNodes = (list: DocTreeNode[]) => {
    list.sort((a, b) => a.order_index - b.order_index);
    for (const item of list) {
      if (item.children && item.children.length > 0) {
        sortNodes(item.children);
      }
    }
  };

  sortNodes(roots);
  return roots;
}

// Depth-first order for prev/next navigation
function flattenPagesDepthFirst(tree: DocTreeNode[]): DocTreeNode[] {
  const pages: DocTreeNode[] = [];
  function traverse(list: DocTreeNode[]) {
    for (const node of list) {
      if (node.kind === 'page') pages.push(node);
      if (node.children && node.children.length > 0) traverse(node.children);
    }
  }
  traverse(tree);
  return pages;
}

const tree = buildTree(treeNodes);
const flatPages = flattenPagesDepthFirst(tree);
const currentIndex = flatPages.findIndex((p) => p.id === currentPage.id);
const prevPage = currentIndex > 0 ? flatPages[currentIndex - 1] : null;
const nextPage =
  currentIndex >= 0 && currentIndex < flatPages.length - 1
    ? flatPages[currentIndex + 1]
    : null;

const getPageHref = (node: DocTreeNode) =>
  node.is_index
    ? `/${owner.username}/${project.slug}/docs`
    : `/${owner.username}/${project.slug}/docs/${node.slug}`;
---

<BaseLayout title={`${currentPage.title} — ${project.name}`}>
  <div class="min-h-screen bg-background text-foreground font-sans flex flex-col">

    {/* ── Top Header ─────────────────────────────────────────────────────── */}
    <header class="sticky top-0 z-40 h-14 border-b border-border bg-background/95 backdrop-blur-sm px-4 sm:px-6 flex items-center justify-between gap-4">
      {/* Left: breadcrumb */}
      <div class="flex items-center gap-2 min-w-0">
        {/* Mobile sidebar toggle — handled by JS below */}
        <button
          id="docs-sidebar-toggle"
          type="button"
          class="md:hidden flex items-center justify-center h-8 w-8 rounded-md hover:bg-surface-raised transition-colors text-text-muted hover:text-foreground shrink-0"
          aria-label="Toggle navigation"
        >
          <Menu className="h-4 w-4" client:load />
        </button>

        <a
          href="/"
          class="font-display font-bold text-base text-foreground hover:text-accent transition-colors shrink-0"
        >
          Showcrate
        </a>
        <span class="text-border-strong">/</span>
        <a
          href={`/${owner.username}`}
          class="text-xs font-mono text-text-muted hover:text-foreground transition-colors truncate"
        >
          @{owner.username}
        </a>
        <span class="text-border-strong">/</span>
        <a
          href={`/${owner.username}/${project.slug}`}
          class="text-xs font-semibold text-text-secondary hover:text-foreground transition-colors truncate"
        >
          {project.name}
        </a>
      </div>

      {/* no edit button in the header — owner can reach editor from /dashboard */}
    </header>

    {/* ── Body: Sidebar + Content ─────────────────────────────────────────── */}
    <div class="flex-1 flex max-w-screen-xl w-full mx-auto relative">

      {/* ── Sidebar overlay for mobile ───────────────────────────────────── */}
      <div
        id="docs-sidebar-overlay"
        class="fixed inset-0 z-30 bg-background/80 backdrop-blur-sm hidden md:hidden"
        aria-hidden="true"
      ></div>

      {/* ── Sidebar ─────────────────────────────────────────────────────── */}
      <aside
        id="docs-sidebar"
        class="fixed md:sticky top-14 left-0 h-[calc(100vh-3.5rem)] z-30 w-72 shrink-0
               border-r border-border bg-background overflow-y-auto
               -translate-x-full md:translate-x-0 transition-transform duration-200 ease-in-out"
      >
        <div class="p-4">
          {/* Sidebar header */}
          <div class="flex items-center justify-between mb-3 pb-3 border-b border-border">
            <span class="text-[10px] font-mono font-semibold uppercase tracking-widest text-text-muted">
              Documentation
            </span>
            <span class="text-[10px] font-mono text-text-muted">
              {flatPages.length} {flatPages.length === 1 ? 'page' : 'pages'}
            </span>
          </div>

          {/* Nav tree */}
          <nav class="space-y-0.5" aria-label="Documentation navigation">
            {tree.map(function renderNode(node: DocTreeNode): any {
              if (node.kind === 'folder') {
                return (
                  <div class="pt-3 pb-1">
                    <div class="flex items-center gap-1.5 px-2 py-1 text-[10px] font-mono font-semibold text-text-muted uppercase tracking-widest">
                      <Folder className="h-3 w-3 shrink-0" client:load />
                      <span class="truncate">{node.title}</span>
                    </div>
                    {node.children && node.children.length > 0 && (
                      <div class="ml-3 pl-2 border-l border-border/60 mt-0.5 space-y-0.5">
                        {node.children.map(renderNode)}
                      </div>
                    )}
                  </div>
                );
              }

              const isCurrent = node.id === currentPage.id;
              return (
                <a
                  href={getPageHref(node)}
                  class={`group flex items-center gap-2 px-2.5 py-1.5 rounded-md text-sm transition-all ${
                    isCurrent
                      ? 'bg-surface-raised text-foreground font-medium border border-border'
                      : 'text-text-secondary hover:text-foreground hover:bg-surface-raised/60'
                  }`}
                  aria-current={isCurrent ? 'page' : undefined}
                >
                  <BookOpen
                    className={`h-3.5 w-3.5 shrink-0 transition-colors ${isCurrent ? 'text-accent' : 'text-text-muted group-hover:text-text-secondary'}`}
                    client:load
                  />
                  <span class="truncate">{node.title}</span>
                  {isCurrent && (
                    <ChevronRight className="h-3 w-3 text-accent ml-auto shrink-0" client:load />
                  )}
                </a>
              );
            })}
          </nav>

          {/* Back to project */}
          <div class="mt-6 pt-4 border-t border-border">
            <a
              href={`/${owner.username}/${project.slug}`}
              class="flex items-center gap-1.5 text-xs text-text-muted hover:text-foreground transition-colors"
            >
              <ArrowLeft className="h-3 w-3" client:load />
              <span>Back to project</span>
            </a>
          </div>
        </div>
      </aside>

      {/* ── Main Content ────────────────────────────────────────────────── */}
      <main class="flex-1 min-w-0 overflow-y-auto">
        <div class="max-w-3xl mx-auto px-5 sm:px-8 lg:px-12 py-10 sm:py-14">

          {/* Page title */}
          <div class="mb-8 pb-6 border-b border-border">
            <div class="min-w-0">
              <div class="text-[10px] font-mono text-text-muted uppercase tracking-widest mb-2">
                {project.name} — docs
              </div>
              <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-foreground leading-tight">
                {currentPage.title}
              </h1>
            </div>
          </div>

          {/* Block content */}
          <article class="docs-content">
            <slot />
          </article>

          {/* ── Prev / Next navigation ──────────────────────────────────── */}
          {(prevPage || nextPage) && (
            <nav
              class="mt-14 pt-6 border-t border-border flex items-stretch justify-between gap-4"
              aria-label="Page navigation"
            >
              {prevPage ? (
                <a
                  href={getPageHref(prevPage)}
                  class="group flex flex-col gap-1 p-4 rounded-xl border border-border hover:border-accent/40 hover:bg-surface-raised/50 transition-all max-w-[48%]"
                >
                  <span class="flex items-center gap-1 text-[10px] font-mono uppercase tracking-widest text-text-muted group-hover:text-accent transition-colors">
                    <ArrowLeft className="h-3 w-3" client:load />
                    Previous
                  </span>
                  <span class="text-sm font-medium text-foreground truncate">
                    {prevPage.title}
                  </span>
                </a>
              ) : (
                <div />
              )}

              {nextPage && (
                <a
                  href={getPageHref(nextPage)}
                  class="group flex flex-col gap-1 p-4 rounded-xl border border-border hover:border-accent/40 hover:bg-surface-raised/50 transition-all max-w-[48%] text-right ml-auto"
                >
                  <span class="flex items-center justify-end gap-1 text-[10px] font-mono uppercase tracking-widest text-text-muted group-hover:text-accent transition-colors">
                    Next
                    <ArrowRight className="h-3 w-3" client:load />
                  </span>
                  <span class="text-sm font-medium text-foreground truncate">
                    {nextPage.title}
                  </span>
                </a>
              )}
            </nav>
          )}

        </div>
      </main>
    </div>
  </div>

  {/* ── Sidebar toggle script ─────────────────────────────────────────────── */}
  <script>
    const toggle = document.getElementById('docs-sidebar-toggle');
    const sidebar = document.getElementById('docs-sidebar');
    const overlay = document.getElementById('docs-sidebar-overlay');

    function openSidebar() {
      sidebar?.classList.remove('-translate-x-full');
      overlay?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
    function closeSidebar() {
      sidebar?.classList.add('-translate-x-full');
      overlay?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    toggle?.addEventListener('click', () => {
      if (sidebar?.classList.contains('-translate-x-full')) {
        openSidebar();
      } else {
        closeSidebar();
      }
    });
    overlay?.addEventListener('click', closeSidebar);
  </script>
</BaseLayout>

<style>
  /* ── Docs prose content styles ──────────────────────────────────────────── */
  .docs-content {
    color: var(--text);
    font-size: 0.9375rem;
    line-height: 1.75;
  }

  .docs-content p {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .docs-content p:last-child {
    margin-bottom: 0;
  }

  /* Headings */
  .docs-content h1,
  .docs-content h2,
  .docs-content h3,
  .docs-content h4,
  .docs-content h5,
  .docs-content h6 {
    font-family: var(--font-display);
    color: var(--text);
    scroll-margin-top: 5rem;
  }

  /* Links in prose */
  .docs-content a {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 150ms;
  }
  .docs-content a:hover {
    color: var(--link-hover);
  }

  /* Inline code */
  .docs-content code:not(pre code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    padding: 0.1em 0.4em;
    color: var(--accent);
  }

  /* Blockquote */
  .docs-content blockquote {
    border-left: 4px solid var(--accent);
    margin-left: 0;
    padding-left: 1rem;
    color: var(--text-secondary);
    font-style: italic;
  }

  /* Lists */
  .docs-content ul,
  .docs-content ol {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
  .docs-content li {
    margin-bottom: 0.25rem;
  }

  /* HR */
  .docs-content hr {
    border-color: var(--border);
  }

  /* Tables */
  .docs-content table {
    font-size: 0.875rem;
  }

  /* Images */
  .docs-content img {
    border-radius: 0.5rem;
    border: 1px solid var(--border);
  }

  /* Shiki code block override — use our surface, not Shiki's background */
  .docs-content .shiki {
    background-color: var(--surface) !important;
  }
</style>
