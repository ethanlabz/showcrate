---
// src/layouts/Docs.astro
import BaseLayout from './BaseLayout.astro';
import {
  BookOpen,
  ChevronRight,
  Folder,
  ArrowLeft,
  ArrowRight,
  Edit3,
  ExternalLink,
} from 'lucide-react';

export interface DocTreeNode {
  id: string;
  parent_id: string | null;
  kind: 'page' | 'folder';
  title: string;
  slug: string | null;
  order_index: number;
  is_index: boolean;
  children?: DocTreeNode[];
}

export interface Props {
  project: {
    id: string;
    name: string;
    slug: string;
    published?: boolean;
  };
  owner: {
    username: string;
    displayName?: string | null;
  };
  currentPage: {
    id: string;
    title: string;
    slug: string | null;
    is_index: boolean;
  };
  treeNodes: DocTreeNode[];
  isOwner?: boolean;
}

const { project, owner, currentPage, treeNodes, isOwner = false } = Astro.props;

// Build hierarchical tree
function buildTree(nodes: DocTreeNode[]): DocTreeNode[] {
  const map = new Map<string, DocTreeNode>();
  const roots: DocTreeNode[] = [];

  for (const n of nodes) {
    map.set(n.id, { ...n, children: [] });
  }

  for (const n of nodes) {
    const item = map.get(n.id)!;
    if (n.parent_id && map.has(n.parent_id)) {
      map.get(n.parent_id)!.children!.push(item);
    } else {
      roots.push(item);
    }
  }

  const sortNodes = (list: DocTreeNode[]) => {
    list.sort((a, b) => a.order_index - b.order_index);
    for (const item of list) {
      if (item.children && item.children.length > 0) {
        sortNodes(item.children);
      }
    }
  };

  sortNodes(roots);
  return roots;
}

// Depth-first order for prev/next navigation
function flattenPagesDepthFirst(tree: DocTreeNode[]): DocTreeNode[] {
  const pages: DocTreeNode[] = [];
  function traverse(list: DocTreeNode[]) {
    for (const node of list) {
      if (node.kind === 'page') {
        pages.push(node);
      }
      if (node.children && node.children.length > 0) {
        traverse(node.children);
      }
    }
  }
  traverse(tree);
  return pages;
}

const tree = buildTree(treeNodes);
const flatPages = flattenPagesDepthFirst(tree);
const currentIndex = flatPages.findIndex((p) => p.id === currentPage.id);
const prevPage = currentIndex > 0 ? flatPages[currentIndex - 1] : null;
const nextPage =
  currentIndex >= 0 && currentIndex < flatPages.length - 1
    ? flatPages[currentIndex + 1]
    : null;

const getPageHref = (node: DocTreeNode) =>
  node.is_index
    ? `/${owner.username}/${project.slug}/docs`
    : `/${owner.username}/${project.slug}/docs/${node.slug}`;
---

<BaseLayout title={`${currentPage.title} — ${project.name}`}>
  <div class="min-h-screen bg-[#14161B] text-foreground font-sans flex flex-col">
    {/* 1. Header */}
    <header class="sticky top-0 z-40 h-14 border-b border-border/40 bg-[#14161B]/95 backdrop-blur px-4 sm:px-6 flex items-center justify-between">
      <div class="flex items-center gap-3 truncate">
        <a
          href="/"
          class="font-serif font-bold text-lg text-[#C9A96A] hover:opacity-90 transition-opacity shrink-0"
        >
          Showcrate
        </a>
        <span class="text-muted-foreground/40 text-sm">/</span>
        <a
          href={`/${owner.username}`}
          class="text-xs font-mono text-muted-foreground hover:text-foreground truncate"
        >
          @{owner.username}
        </a>
        <span class="text-muted-foreground/40 text-sm">/</span>
        <a
          href={`/${owner.username}/${project.slug}`}
          class="text-xs font-semibold text-foreground hover:text-[#C9A96A] truncate"
        >
          {project.name}
        </a>
      </div>

      <div class="flex items-center gap-2">
        {isOwner && (
          <a
            href={`/editor/${project.id}/${currentPage.id}`}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border border-[#C9A96A]/40 text-[#C9A96A] hover:bg-[#C9A96A]/10 transition-colors"
          >
            <Edit3 className="h-3.5 w-3.5" />
            <span class="hidden sm:inline">Edit in editor</span>
          </a>
        )}
      </div>
    </header>

    {/* 2. Body: Sidebar + Main Content */}
    <div class="flex-1 flex max-w-7xl w-full mx-auto">
      {/* Sidebar */}
      <aside class="w-64 sm:w-72 border-r border-border/40 bg-[#14161B] p-4 shrink-0 overflow-y-auto hidden md:block">
        <div class="mb-4">
          <span class="text-[11px] font-mono uppercase tracking-wider text-muted-foreground font-semibold px-2">
            Documentation
          </span>
        </div>

        <nav class="space-y-1">
          {tree.map(function renderNode(node: DocTreeNode) {
            if (node.kind === 'folder') {
              return (
                <div class="pt-2">
                  <div class="flex items-center gap-2 px-2 py-1 text-xs font-medium text-muted-foreground uppercase tracking-wider">
                    <Folder className="h-3.5 w-3.5 text-[#C9A96A]/70" />
                    <span>{node.title}</span>
                  </div>
                  {node.children && node.children.length > 0 && (
                    <div class="pl-3 border-l border-border/30 ml-3 space-y-1 mt-1">
                      {node.children.map(renderNode)}
                    </div>
                  )}
                </div>
              );
            }

            const isCurrent = node.id === currentPage.id;
            return (
              <a
                href={getPageHref(node)}
                class={`flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs font-medium transition-colors ${
                  isCurrent
                    ? 'bg-surface-raised text-[#C9A96A] font-semibold border border-[#C9A96A]/20'
                    : 'text-foreground/80 hover:text-foreground hover:bg-surface-raised/50'
                }`}
              >
                <BookOpen className={`h-3.5 w-3.5 shrink-0 ${isCurrent ? 'text-[#C9A96A]' : 'text-muted-foreground'}`} />
                <span class="truncate">{node.title}</span>
              </a>
            );
          })}
        </nav>
      </aside>

      {/* Main Content */}
      <main class="flex-1 p-6 sm:p-10 lg:p-12 overflow-y-auto max-w-3xl">
        <div class="mb-8 border-b border-border/40 pb-6">
          <div class="flex items-start justify-between gap-4">
            <h1 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight text-foreground">
              {currentPage.title}
            </h1>
            {isOwner && (
              <a
                href={`/editor/${project.id}/${currentPage.id}`}
                class="text-xs text-[#C9A96A] hover:underline flex items-center gap-1 font-medium shrink-0 pt-2"
              >
                <Edit3 className="h-3.5 w-3.5" />
                <span>Edit</span>
              </a>
            )}
          </div>
        </div>

        <article class="prose prose-invert max-w-none text-foreground leading-relaxed">
          <slot />
        </article>

        {/* Prev / Next Pagination */}
        <div class="mt-12 pt-6 border-t border-border/40 flex items-center justify-between gap-4">
          {prevPage ? (
            <a
              href={getPageHref(prevPage)}
              class="flex flex-col items-start gap-1 p-3 rounded-lg border border-border/40 hover:bg-surface-raised transition-colors max-w-[45%]"
            >
              <span class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground flex items-center gap-1">
                <ArrowLeft className="h-3 w-3" /> Previous
              </span>
              <span class="text-xs font-medium text-foreground truncate block">
                {prevPage.title}
              </span>
            </a>
          ) : <div />}

          {nextPage && (
            <a
              href={getPageHref(nextPage)}
              class="flex flex-col items-end gap-1 p-3 rounded-lg border border-border/40 hover:bg-surface-raised transition-colors max-w-[45%] text-right ml-auto"
            >
              <span class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground flex items-center gap-1">
                Next <ArrowRight className="h-3 w-3" />
              </span>
              <span class="text-xs font-medium text-foreground truncate block">
                {nextPage.title}
              </span>
            </a>
          )}
        </div>
      </main>
    </div>
  </div>
</BaseLayout>