---
import BaseLayout from "./BaseLayout.astro";

import { AppShell } from "../components/pages/app/app-shell";
import { MobileBottomNav } from "../components/pages/app/mobile-bottom-nav";

export interface Props {
  title: string;
  description?: string;
  noIndex?: boolean;
}

const { title, description, noIndex = true } = Astro.props;
const user = Astro.locals.user;

if (user && !user.username) {
  return Astro.redirect('/auth/signup?social=true');
}
---

<BaseLayout title={title} description={description} noIndex={noIndex}>
  <AppShell user={user} client:load>
    <slot />
  </AppShell>

  <MobileBottomNav username={user?.username ?? ''} client:load />
</BaseLayout>
