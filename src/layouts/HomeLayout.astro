---
import BaseLayout from './BaseLayout.astro';
import { Header } from '../components/pages/home/home-header.tsx';
import { Footer } from '@/components/pages/home/home-footer';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  hideFooter?: boolean;
}

const {
  title,
  description,
  ogImage,
  noIndex,
  hideFooter = false,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  noIndex={noIndex}
>
  <div class='flex flex-col min-h-screen'>
    <header>
      <Header client:load currentPath={Astro.url.pathname} />
    </header>

    <main class='flex-1'>
      <slot />
    </main>

    {
      !hideFooter && (
        <footer>
          <Footer client:load />
        </footer>
      )
    }
  </div>
</BaseLayout>

<script>
  import Lenis from 'lenis';

  const lenis = new Lenis();
  // Expose to window for GSAP synchronization
  (window as any).lenis = lenis;

  function raf(time: number) {
    lenis.raf(time);
    requestAnimationFrame(raf);
  }

  requestAnimationFrame(raf);
</script>
