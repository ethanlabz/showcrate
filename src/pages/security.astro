---
import LandingLayout from "@/layouts/HomeLayout.astro";
import { Shield, ShieldAlert, ShieldCheck } from "lucide-react";
---

<LandingLayout title="Security - Showcrate">
  <div class="relative min-h-screen pb-32">
    <!-- Abstract Background -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[300px] bg-primary/10 blur-[100px] pointer-events-none mix-blend-screen rounded-full"></div>
    
    <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8 pt-32 lg:pt-40 max-w-4xl text-center mb-16">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-card border border-border shadow-lg mb-8 text-primary">
        <Shield className="w-10 h-10" />
      </div>
      <h1 class="text-5xl sm:text-6xl font-extrabold tracking-tight mb-8">
        Security at Showcrate
      </h1>
      <p class="text-xl text-muted-foreground leading-relaxed max-w-2xl mx-auto text-balance">
        We take the security of your code, documentation, and user data very seriously. Showcrate is built from the ground up with security in mind.
      </p>
    </div>

    <!-- Content Grid -->
    <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        <div class="p-8 rounded-3xl bg-card/40 border border-border/50 backdrop-blur-sm">
          <ShieldCheck className="w-8 h-8 text-green-500 mb-4" />
          <h3 class="text-2xl font-bold mb-3 text-foreground">Secure by Design</h3>
          <p class="text-muted-foreground leading-relaxed">
            All code execution happens directly in the user's browser via WebContainers. Your servers are never exposed to arbitrary code execution risks.
          </p>
        </div>
        <div class="p-8 rounded-3xl bg-card/40 border border-border/50 backdrop-blur-sm">
          <ShieldAlert className="w-8 h-8 text-amber-500 mb-4" />
          <h3 class="text-2xl font-bold mb-3 text-foreground">Vulnerability Reporting</h3>
          <p class="text-muted-foreground leading-relaxed">
            If you believe you've found a security vulnerability in Showcrate, please report it to <a href="mailto:security@showcrate.test" class="text-primary hover:underline">security@showcrate.test</a>. We aim to respond within 24 hours.
          </p>
        </div>
      </div>
      
      <div class="prose prose-invert prose-lg max-w-none prose-headings:text-foreground prose-p:text-muted-foreground pt-12 border-t border-border/50">
        <h2>Data Privacy</h2>
        <p>Showcrate is fully compliant with GDPR and CCPA. We do not sell your data, and you retain full ownership of any code or documentation you host on our platform.</p>
        
        <h2>Infrastructure</h2>
        <p>Our backend services are hosted on enterprise-grade cloud providers with physical and network security verified through SOC 2 audits.</p>
      </div>
    </div>
  </div>
</LandingLayout>
