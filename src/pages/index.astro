---
import PublicLayout from "@/layouts/PublicLayout.astro";
import "lenis/dist/lenis.css";
import { Button } from "@/components/ui/button";
import { ChevronRight, Zap, CheckCircle2 } from "lucide-react";
---

<PublicLayout title="Showcrate - Interactive Documentation">
  <div class="relative w-full">
    <!-- ========================================== -->
    <!-- 1. HERO SECTION                            -->
    <!-- Headline, CTA buttons, and preview mockup  -->
    <!-- ========================================== -->
    <section
      id="hero-section"
      class="relative min-h-[90vh] md:min-h-[100vh] flex flex-col pt-4 sm:pt-20 md:pt-20 lg:pt-20 xl:pt-20 2xl:pt-20 overflow-hidden pb-32 sm:pb-20 md:pb-24 lg:pb-32 2xl:pb-40 justify-center"
    >
      <!-- Abstract Background -->
      <div
        class="absolute inset-0 -top-40 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/30 via-background to-background pointer-events-none"
      >
      </div>

      <div
        class="w-full max-w-7xl 2xl:max-w-[1700px] relative z-10 mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-center gap-12 xl:gap-20 2xl:gap-32"
      >
        <!-- Left Column: Text -->
        <div
          class="flex-1 text-center lg:text-left flex flex-col items-center lg:items-start w-full z-20"
        >
          <div
            class="inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-sm font-medium text-primary mb-4 sm:mb-8 md:mb-10 backdrop-blur-sm"
          >
            <span class="flex h-2 w-2 rounded-full bg-primary mr-2"></span>
            Introducing Showcrate 1.0
          </div>

          <h1
            class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl 2xl:text-[8rem] 2xl:leading-[1.1] font-extrabold tracking-tighter max-w-5xl 2xl:max-w-7xl mb-4 sm:mb-8 md:mb-10 2xl:mb-12 text-foreground"
          >
            Documentation that tells a <span
              class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary/60"
              >story.</span
            >
          </h1>

          <p
            class="text-base sm:text-lg md:text-xl lg:text-2xl 2xl:text-3xl text-muted-foreground font-medium max-w-2xl 2xl:max-w-4xl mb-8 sm:mb-12 md:mb-16 2xl:mb-20 leading-snug"
          >
            Stop writing boring walls of text. Showcrate brings your code to
            life with interactive, dynamic, and beautiful documentation.
          </p>

          <div
            class="flex flex-col sm:flex-row gap-3 sm:gap-6 w-full sm:w-auto items-center lg:items-start"
          >
            <a href="/auth/signup" class="w-full sm:w-auto">
              <Button
                size="lg"
                className="h-12 sm:h-14 2xl:h-16 px-6 sm:px-8 2xl:px-10 text-sm sm:text-base 2xl:text-lg w-full sm:w-auto rounded-full"
              >
                Start Writing <ChevronRight
                  className="ml-2 h-4 w-4 2xl:h-5 2xl:w-5"
                />
              </Button>
            </a>
            <a href="/docs/introduction" class="w-full sm:w-auto">
              <Button
                variant="outline"
                size="lg"
                className="h-12 sm:h-14 2xl:h-16 px-6 sm:px-8 2xl:px-10 text-sm sm:text-base 2xl:text-lg w-full sm:w-auto rounded-full bg-background/50 backdrop-blur-sm"
              >
                Explore Docs
              </Button>
            </a>
          </div>
        </div>

        <!-- Right Column: Technical Blueprint Mockup -->
        <div
          class="flex-1 w-full hidden lg:block relative z-10 mt-10 lg:mt-0 2xl:pl-10"
        >
          <div
            class="relative w-full max-w-xl xl:max-w-2xl 2xl:max-w-4xl mx-auto transition-transform duration-500 hover:-translate-y-2"
          >
            <!-- Brutalist Shadow Offset -->
            <div
              class="absolute inset-0 translate-x-4 translate-y-4 bg-primary border-2 border-foreground z-[-1] rounded-sm hidden sm:block"
            >
            </div>

            <!-- Main Technical Container -->
            <div
              class="relative bg-background border-2 border-foreground rounded-sm overflow-hidden flex flex-col h-full shadow-2xl"
            >
              <!-- Technical Header -->
              <div
                class="flex items-center justify-between px-4 py-3 border-b-2 border-foreground bg-muted/40"
              >
                <div class="flex items-center gap-4">
                  <span
                    class="text-xs font-mono uppercase tracking-widest text-foreground font-bold flex items-center gap-2"
                  >
                    <span class="w-2 h-2 bg-primary"></span>
                    Showcrate Preview
                  </span>
                  <div class="hidden sm:block h-4 w-px bg-foreground/30"></div>
                  <span
                    class="hidden sm:block text-[10px] font-mono text-muted-foreground uppercase bg-foreground/5 px-2 py-0.5 border border-foreground/20 rounded-sm"
                    >Live Environment</span
                  >
                </div>
                <div class="flex gap-1.5">
                  <div
                    class="w-3 h-3 bg-background border border-foreground rounded-sm"
                  >
                  </div>
                  <div
                    class="w-3 h-3 bg-foreground border border-foreground rounded-sm"
                  >
                  </div>
                </div>
              </div>

              <!-- Content Grid Layout -->
              <div
                class="flex flex-col md:flex-row h-auto min-h-[380px] divide-y-2 md:divide-y-0 md:divide-x-2 divide-foreground"
              >
                <!-- Left: Markdown Source -->
                <div
                  class="flex-1 bg-muted/10 p-0 flex flex-col relative group"
                >
                  <div
                    class="absolute top-0 right-0 bg-primary text-primary-foreground text-[10px] font-mono font-bold px-2 py-1 border-b-2 border-l-2 border-foreground"
                  >
                    src/demo.md
                  </div>
                  <div
                    class="w-full h-full p-6 pt-10 text-xs sm:text-sm font-mono leading-relaxed text-foreground/90 overflow-hidden"
                  >
                    <pre><code><span class="text-muted-foreground"># Button</span>

Try it out.

<span class="text-primary/70">```jsx</span>
import &#123; Button &#125; from "showcrate";

&lt;Button&gt;Interact&lt;/Button&gt;
<span class="text-primary/70">```</span>
</code></pre>
                  </div>
                </div>

                <!-- Right: Rendered Output -->
                <div
                  class="flex-1 bg-[linear-gradient(to_right,#80808020_1px,transparent_1px),linear-gradient(to_bottom,#80808020_1px,transparent_1px)] bg-[size:16px_16px] relative flex flex-col"
                >
                  <div
                    class="absolute top-0 left-0 bg-foreground text-background text-[10px] font-mono font-bold px-2 py-1 uppercase border-b-2 border-r-2 border-foreground"
                  >
                    Output
                  </div>

                  <div class="flex-1 flex flex-col p-6 pt-10 gap-4 text-left">
                    <h1
                      class="text-2xl font-bold tracking-tight text-foreground border-b-2 border-foreground/10 pb-2"
                    >
                      Button
                    </h1>

                    <p class="text-sm text-foreground/80 font-medium">
                      Try it out.
                    </p>

                    <!-- Brutalist Button Demo Container -->
                    <div
                      class="mt-2 p-8 border-2 border-dashed border-foreground/30 bg-muted/20 rounded-sm flex items-center justify-center"
                    >
                      <!-- Brutalist Button Demo -->
                      <button
                        class="relative group/btn cursor-pointer outline-none w-full max-w-[200px]"
                      >
                        <div
                          class="absolute inset-0 translate-x-1.5 translate-y-1.5 bg-foreground transition-transform group-active/btn:translate-x-0 group-active/btn:translate-y-0 rounded-sm"
                        >
                        </div>
                        <div
                          class="relative px-6 py-4 bg-primary border-2 border-foreground text-primary-foreground font-mono font-bold text-sm tracking-wider uppercase rounded-sm transition-transform group-active/btn:translate-x-1.5 group-active/btn:translate-y-1.5 flex justify-center"
                        >
                          Interact
                        </div>
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Status Bar -->
              <div
                class="flex items-center justify-between px-4 py-2 border-t-2 border-foreground bg-muted/40 text-[10px] sm:text-xs font-mono uppercase tracking-wider text-muted-foreground"
              >
                <div class="flex items-center gap-2 font-bold text-foreground">
                  <span
                    class="w-2.5 h-2.5 bg-green-500 animate-pulse border border-green-700"
                  ></span>
                  Ready
                </div>
                <div class="hidden sm:block">Server: WebContainer</div>
                <div>Port: 3000</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Decorative blurry glowing orbs -->
      <div
        class="absolute top-1/4 left-1/4 w-48 h-48 sm:w-64 sm:h-64 md:w-72 md:h-72 lg:w-96 lg:h-96 bg-primary/30 rounded-full blur-[100px] -z-10 animate-pulse mix-blend-screen"
      >
      </div>
      <div
        class="absolute bottom-1/4 right-1/4 w-64 h-64 sm:w-80 sm:h-80 md:w-96 md:h-96 lg:w-[32rem] lg:h-[32rem] bg-primary/20 rounded-full blur-[120px] -z-10 mix-blend-screen"
      >
      </div>
    </section>

    <!-- ========================================== -->
    <!-- 2. PROBLEM SECTION                         -->
    <!-- "Most documentation feels like a graveyard"-->
    <!-- ========================================== -->
    <div id="problem-section" class="py-24 sm:py-32 md:py-40">
      <div
        class="w-full max-w-7xl 2xl:max-w-[1700px] mx-auto px-4 sm:px-6 lg:px-8"
      >
        <div class="max-w-4xl 2xl:max-w-6xl mx-auto text-center md:text-left">
          <h2
            class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl 2xl:text-[6rem] 2xl:leading-[1.05] font-extrabold tracking-tighter mb-8 sm:mb-10 md:mb-12 lg:mb-16 2xl:mb-20 text-foreground"
            id="story-1-text"
          >
            {
              "Most documentation feels like a graveyard of text."
                .split(" ")
                .map((word) => (
                  <>
                    <span class="story-word inline-block opacity-0 translate-y-4">
                      {word}
                    </span>{" "}
                  </>
                ))
            }
          </h2>
          <p
            class="text-lg sm:text-xl md:text-2xl lg:text-3xl 2xl:text-3xl text-muted-foreground font-medium leading-relaxed"
            id="story-1-subtext"
          >
            {
              "It's static, disconnected from reality, and hard to maintain. Your users struggle to bridge the gap between reading the docs and running the code."
                .split(" ")
                .map((word) => (
                  <>
                    <span class="story-word-sub inline-block opacity-0 translate-y-2">
                      {word}
                    </span>{" "}
                  </>
                ))
            }
          </p>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- 3. SOLUTION SECTION                        -->
    <!-- "Bring your code to life" features         -->
    <!-- ========================================== -->
    <div id="solution-section" class="py-24 sm:py-32 md:py-40">
      <div
        class="w-full max-w-7xl 2xl:max-w-[1700px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full"
      >
        <div
          class="flex flex-col items-center text-center max-w-5xl 2xl:max-w-6xl mx-auto"
        >
          <!-- Eyebrow and Icon -->
          <div
            class="flex items-center gap-3 sm:gap-4 mb-6 sm:mb-8 md:mb-10 2xl:mb-12 justify-center"
          >
            <div
              class="interactive-icon-anim opacity-0 translate-y-8 translate-x-[85px] relative inline-flex h-12 w-12 sm:h-14 sm:w-14 2xl:h-16 2xl:w-16 items-center justify-center rounded-2xl z-10 group"
            >
              <!-- Outer bloom -->
              <div
                class="absolute inset-0 rounded-2xl bg-primary/20 blur-xl group-hover:bg-primary/40 group-hover:blur-2xl transition-all duration-700"
              >
              </div>
              <!-- Gradient border wrapper -->
              <div
                class="absolute inset-0 rounded-2xl bg-gradient-to-b from-primary/80 via-primary/20 to-transparent p-[1px] shadow-[inset_0_1px_0_rgba(255,255,255,0.2)]"
              >
                <!-- Inner glass background -->
                <div
                  class="absolute inset-[1px] rounded-[15px] bg-background/95 backdrop-blur-xl flex items-center justify-center overflow-hidden"
                >
                  <!-- Subtle top highlight for 3D bevel effect -->
                  <div
                    class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"
                  >
                  </div>
                  <!-- Ambient inner glow -->
                  <div
                    class="absolute bottom-0 inset-x-0 h-1/2 bg-gradient-to-t from-primary/10 to-transparent"
                  >
                  </div>

                  <!-- Icon -->
                  <Zap
                    className="h-5 w-5 sm:h-6 sm:w-6 2xl:h-8 2xl:w-8 text-primary drop-shadow-[0_0_12px_var(--color-primary)] relative z-10 group-hover:scale-110 transition-transform duration-500 ease-out"
                  />
                </div>
              </div>
            </div>
            <div class="interactive-text-anim opacity-0 -translate-x-8">
              <div
                class="px-4 py-1.5 sm:px-5 sm:py-2 rounded-full bg-background/50 border border-primary/20 backdrop-blur-md shadow-sm relative overflow-hidden group-hover:border-primary/40 transition-colors duration-500"
              >
                <div
                  class="absolute inset-0 bg-gradient-to-r from-primary/10 to-transparent opacity-50"
                >
                </div>
                <span
                  class="relative text-[10px] sm:text-xs 2xl:text-sm font-bold uppercase tracking-[0.25em] text-primary whitespace-nowrap"
                  >Interactive Editor</span
                >
              </div>
            </div>
          </div>

          <h2
            class="solution-fade-in opacity-0 translate-y-8 text-4xl sm:text-5xl md:text-6xl lg:text-7xl 2xl:text-7xl font-extrabold tracking-tighter mb-6 sm:mb-8 2xl:mb-10 text-foreground"
          >
            Bring your code to life.
          </h2>

          <p
            class="solution-fade-in opacity-0 translate-y-8 text-base sm:text-lg md:text-xl 2xl:text-xl text-muted-foreground leading-relaxed mb-10 sm:mb-12 2xl:mb-12 max-w-3xl 2xl:max-w-4xl"
          >
            Showcrate turns standard markdown into a fully-fledged interactive
            playground. It's not just a documentation site; it's a live IDE in
            the browser.
          </p>

          <ul
            class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 w-full text-left"
          >
            <li
              class="solution-fade-in opacity-0 translate-y-8 flex flex-col items-start bg-background/80 backdrop-blur-md border border-border/50 rounded-xl p-5 sm:p-6"
            >
              <div class="bg-primary/20 p-2 rounded-lg mb-4 shrink-0">
                <CheckCircle2 className="h-6 w-6 text-primary" />
              </div>
              <div>
                <span
                  class="block text-foreground font-semibold mb-2 text-base sm:text-lg"
                  >Instant deployments</span
                >
                <span class="text-sm text-muted-foreground leading-relaxed"
                  >Runs WebContainers directly in the user's browser securely.</span
                >
              </div>
            </li>
            <li
              class="solution-fade-in opacity-0 translate-y-8 flex flex-col items-start bg-background/80 backdrop-blur-md border border-border/50 rounded-xl p-5 sm:p-6"
            >
              <div class="bg-primary/20 p-2 rounded-lg mb-4 shrink-0">
                <CheckCircle2 className="h-6 w-6 text-primary" />
              </div>
              <div>
                <span
                  class="block text-foreground font-semibold mb-2 text-base sm:text-lg"
                  >File-system emulation</span
                >
                <span class="text-sm text-muted-foreground leading-relaxed"
                  >Write to files, use Node.js APIs, and run package managers.</span
                >
              </div>
            </li>
            <li
              class="solution-fade-in opacity-0 translate-y-8 flex flex-col items-start bg-background/80 backdrop-blur-md border border-border/50 rounded-xl p-5 sm:p-6"
            >
              <div class="bg-primary/20 p-2 rounded-lg mb-4 shrink-0">
                <CheckCircle2 className="h-6 w-6 text-primary" />
              </div>
              <div>
                <span
                  class="block text-foreground font-semibold mb-2 text-base sm:text-lg"
                  >Shareable snippets</span
                >
                <span class="text-sm text-muted-foreground leading-relaxed"
                  >Embed your live environments anywhere with one click.</span
                >
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
    <!-- ========================================== -->
    <!-- 4. INTERACTIVE EDITOR MOCKUP               -->
    <!-- Live typing and rendering demonstration    -->
    <!-- ========================================== -->
    <section
      id="editor-mockup-container"
      class="relative z-10 w-full min-h-screen bg-background flex flex-col items-center justify-center py-16"
    >
      <div
        class="w-full max-w-7xl 2xl:max-w-[1700px] mx-auto px-4 sm:px-6 lg:px-8"
      >
        <div
          class="editor-window opacity-0 translate-y-12 scale-95 relative w-full max-w-6xl mx-auto"
        >
          <div
            class="absolute inset-0 bg-gradient-to-r from-primary to-secondary blur-3xl opacity-20 rounded-full"
          >
          </div>
          <div
            class="relative rounded-2xl border border-border bg-background/80 backdrop-blur-xl shadow-2xl overflow-hidden flex flex-col group hover:border-primary/50 transition-colors duration-500"
          >
            <!-- Window Header -->
            <div
              class="flex items-center justify-between px-4 py-2.5 border-b border-border/80 bg-muted/20 backdrop-blur-md"
            >
              <!-- Left: Window Controls -->
              <div class="flex items-center gap-4">
                <div class="flex gap-1.5 sm:gap-2">
                  <div
                    class="h-2.5 w-2.5 sm:h-3 sm:w-3 rounded-full bg-[#FF5F56] border border-[#E0443E]"
                  >
                  </div>
                  <div
                    class="h-2.5 w-2.5 sm:h-3 sm:w-3 rounded-full bg-[#FFBD2E] border border-[#DEA123]"
                  >
                  </div>
                  <div
                    class="h-2.5 w-2.5 sm:h-3 sm:w-3 rounded-full bg-[#27C93F] border border-[#1AAB29]"
                  >
                  </div>
                </div>

                <!-- File Path / Breadcrumb -->
                <div
                  class="hidden sm:flex items-center text-[11px] text-muted-foreground font-mono bg-background/50 px-2 py-1 rounded-md border border-border/50 shadow-inner select-none"
                >
                  <svg
                    class="w-3 h-3 mr-1.5 text-primary"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
                    ></path></svg
                  >
                  showcrate<span class="mx-1.5 text-border">/</span><span
                    class="text-foreground">README.md</span
                  >
                </div>
              </div>

              <!-- Right: Status / Actions -->
              <div class="flex items-center gap-3">
                <div
                  class="flex items-center gap-1.5 text-[10px] sm:text-[11px] font-bold tracking-wide uppercase text-success bg-success/10 border border-success/20 px-2.5 py-1 rounded-full select-none"
                >
                  <span class="relative flex h-1.5 w-1.5">
                    <span
                      class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"
                    ></span>
                    <span
                      class="relative inline-flex rounded-full h-1.5 w-1.5 bg-success"
                    ></span>
                  </span>
                  Live
                </div>
                <a
                  href="/editor"
                  class="flex relative z-50 items-center gap-1.5 h-6 px-2.5 rounded-md bg-primary/10 hover:bg-primary/20 text-primary transition-colors cursor-pointer group"
                  title="Open in Full Screen"
                >
                  <span
                    class="text-[10px] font-bold uppercase tracking-wider group-hover:text-primary transition-colors"
                    >Open Editor</span
                  >
                  <svg
                    class="w-3.5 h-3.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    ></path></svg
                  >
                </a>
              </div>
            </div>

            <!-- Mobile Tabs -->
            <div class="sm:hidden flex border-b border-border/80 bg-card">
              <button
                id="tab-code"
                class="flex-1 py-3 text-xs font-bold border-b-2 border-primary text-foreground transition-colors uppercase tracking-widest"
                >Editor</button
              >
              <button
                id="tab-preview"
                class="flex-1 py-3 text-xs font-bold border-b-2 border-transparent text-muted-foreground transition-colors uppercase tracking-widest"
                >Preview</button
              >
            </div>

            <!-- Split Content -->
            <div
              class="grid grid-cols-1 sm:grid-cols-5 divide-y sm:divide-y-0 sm:divide-x divide-border/80"
            >
              <!-- Left: Editor Pane (3/5 width) -->
              <div
                id="pane-code"
                class="sm:col-span-3 bg-card/40 p-0 overflow-hidden min-h-[250px] sm:min-h-[350px] flex flex-col font-mono text-sm relative group/editor border-r border-transparent focus-within:border-primary/50 transition-colors"
              >
                <textarea
                  id="interactive-editor"
                  class="w-full h-full min-h-[250px] sm:min-h-[350px] p-4 sm:p-6 bg-transparent text-primary/80 focus:text-primary whitespace-pre-wrap leading-relaxed outline-none resize-none z-10 font-mono placeholder:text-muted-foreground/50 transition-colors"
                  spellcheck="false"
                  placeholder="Type some markdown here..."></textarea>
                <!-- Edit Badge -->
                <div
                  class="absolute top-4 right-4 bg-primary/20 text-primary text-[10px] uppercase font-bold px-2 py-1 rounded opacity-50 group-focus-within/editor:opacity-100 transition-opacity pointer-events-none z-20"
                >
                  Editable
                </div>
              </div>

              <!-- Right: Preview Pane (2/5 width) -->
              <div
                id="pane-preview"
                class="hidden sm:flex sm:col-span-2 bg-background flex-col items-center justify-center p-6 min-h-[250px] sm:min-h-[350px] relative overflow-hidden"
              >
                <!-- Subtle grid background for the preview -->
                <div
                  class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:12px_12px]"
                >
                </div>

                <div
                  id="typewriter-preview"
                  class="relative z-10 text-left flex flex-col w-full h-full border border-dashed border-primary/20 rounded-lg bg-card/30 p-4 overflow-y-auto"
                >
                  <!-- Live preview content injected here -->
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- 5. FEATURES GRID SECTION                   -->
    <!-- Secondary features (MDX, SSG, etc.)        -->
    <!-- ========================================== -->
    <section
      id="features-grid"
      class="relative py-24 sm:py-32 bg-background overflow-hidden border-t border-border/50"
    >
      <div
        class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl"
      >
        <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-24">
          <h2
            class="type-animate text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tighter mb-6 text-foreground"
          >
            Built for the modern web
          </h2>
          <p
