---
import HomeLayout from '@/layouts/HomeLayout.astro';
import 'lenis/dist/lenis.css';
import ScrollReveal from '@/components/animations/ScrollReveal';
import { Button } from '@/components/ui/button';

import { InteractiveEditor } from '@/components/pages/home/interactive-editor';
import {
  HeroContent,
  FeatureGrid,
  StepList,
} from '@/components/pages/home/landing-content';
import { TopographyBackground } from '@/components/backgrounds/topography';

// Authenticated users never see the landing page — go to dashboard
if (Astro.locals.user?.username) {
  return Astro.redirect('/dashboard', 302);
}
---

<HomeLayout title='Welcome'>
  <div class='relative w-full'>
    <!-- ================= HERO ================= -->
    <section
      id='hero-section'
      class='relative flex min-h-svh flex-col items-center justify-center overflow-hidden px-4 pt-32 pb-24 sm:px-6'
    >
      <TopographyBackground
        className='pointer-events-none absolute inset-0 z-0 text-accent/40 mask-[linear-gradient(to_bottom,black_35%,transparent)]'
        client:load
      />
      <div
        aria-hidden='true'
        class='pointer-events-none absolute inset-x-0 bottom-0 z-0 h-48 bg-linear-to-b from-transparent to-background'
      >
      </div>

      <HeroContent client:only='react' />
    </section>

    <!-- ================= LIVE EDITOR ================= -->
    <section
      id='editor'
      class='relative z-10 border-t border-border/50 bg-background px-4 py-24 sm:px-6 sm:py-32'
    >
      <div class='mx-auto max-w-4xl'>
        <ScrollReveal client:load className='mx-auto mb-12 max-w-2xl text-center'>
          <p
            class='mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-primary'
          >
            Try it
          </p>
          <h2
            class='font-display text-3xl font-bold tracking-tight text-balance sm:text-4xl'
          >
            This editor is live. Go ahead and type.
          </h2>
          <p class='mt-4 text-muted-foreground text-balance sm:text-lg'>
            What you see below is the real editor. Your changes are saved in
            your browser.
          </p>
        </ScrollReveal>

        <ScrollReveal
          client:load
          distance={48}
          scale={0.97}
          duration={0.9}
          amount={0.15}
        >
          <InteractiveEditor client:only='react'>
            <div
              slot='fallback'
              class='min-h-104 animate-pulse rounded-2xl border border-border/70 bg-muted/30'
            >
            </div>
          </InteractiveEditor>
        </ScrollReveal>
      </div>
    </section>

    <!-- ================= FEATURES ================= -->
    <section
      id='features'
      class='relative border-t border-border/50 bg-background px-4 py-24 sm:px-6 sm:py-32'
    >
      <div class='mx-auto max-w-6xl'>
        <ScrollReveal
          client:load
          className='mx-auto mb-14 max-w-2xl text-center sm:mb-20'
        >
          <p
            class='mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-primary'
          >
            Features
          </p>
          <h2
            class='font-display text-3xl font-bold tracking-tight text-balance sm:text-4xl md:text-5xl'
          >
            Built for the modern web
          </h2>
          <p class='mt-4 text-muted-foreground text-balance sm:text-lg'>
            Everything you need to publish documentation that people actually
            enjoy reading.
          </p>
        </ScrollReveal>

        <FeatureGrid client:load />
      </div>
    </section>

    <!-- ================= HOW IT WORKS ================= -->
    <section
      id='how-it-works'
      class='relative border-t border-border/50 bg-background px-4 py-24 sm:px-6 sm:py-32'
    >
      <div class='mx-auto max-w-6xl'>
        <ScrollReveal client:load className='mb-14 max-w-2xl sm:mb-20'>
          <p
            class='mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-primary'
          >
            How it works
          </p>
          <h2
            class='font-display text-3xl font-bold tracking-tight text-balance sm:text-4xl md:text-5xl'
          >
            From idea to showcase in three steps
          </h2>
        </ScrollReveal>

        <StepList client:load />
      </div>
    </section>

    <!-- ================= CTA ================= -->
    <section
      id='cta-section'
      class='relative border-t border-border/50 bg-background px-4 py-24 sm:px-6 sm:py-32'
    >
      <ScrollReveal
        client:load
        distance={32}
        scale={0.97}
        duration={0.9}
        className='relative mx-auto max-w-5xl overflow-hidden rounded-3xl border border-border/60 bg-card/50 px-6 py-16 text-center sm:px-12 sm:py-24'
      >
        <div
          aria-hidden='true'
          class='pointer-events-none absolute left-1/2 top-0 h-64 w-[36rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/20 blur-3xl'
        >
        </div>

        <div class='relative flex flex-col items-center'>
          <h2
            class='font-display text-3xl font-bold tracking-tight text-balance sm:text-5xl'
          >
            Ready to show your work?
          </h2>
          <p
            class='mt-5 max-w-xl text-muted-foreground text-balance sm:text-lg'
          >
            Create your first project page in minutes, or explore what others
            have built.
          </p>
          <div
            class='mt-10 flex w-full flex-col items-center gap-3 sm:w-auto sm:flex-row sm:gap-4'
          >
            <a href='/dashboard' class='w-full sm:w-auto'>
              <Button size='lg' className='h-12 w-full px-8 sm:w-auto'>
                Open dashboard
              </Button>
            </a>
            <a href='/playground' class='w-full sm:w-auto'>
              <Button
                variant='outline'
                size='lg'
                className='h-12 w-full px-8 sm:w-auto'
              >
                Try the playground
              </Button>
            </a>
          </div>
        </div>
      </ScrollReveal>
    </section>
  </div>
</HomeLayout>