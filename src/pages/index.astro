---
import LandingLayout from "@/layouts/LandingLayout.astro";
import "lenis/dist/lenis.css";
import { Button } from "@/components/ui/Button";
import { ChevronRight, Zap, CheckCircle2 } from "lucide-react";
---

<LandingLayout title="Showcrate - Interactive Documentation">
  <div class="relative w-full">
    <!-- ========================================== -->
    <!-- 1. HERO SECTION                            -->
    <!-- Headline, CTA buttons, and preview mockup  -->
    <!-- ========================================== -->
    <section id="hero-section" class="relative min-h-[90vh] md:min-h-[100vh] flex flex-col pt-4 sm:pt-20 md:pt-20 lg:pt-20 xl:pt-20 2xl:pt-20 overflow-hidden pb-32 sm:pb-20 md:pb-24 lg:pb-32 2xl:pb-40 justify-center">
      <!-- Abstract Background -->
      <div class="absolute inset-0 -top-40 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/30 via-background to-background pointer-events-none"></div>

      <div class="w-full max-w-7xl 2xl:max-w-[1700px] relative z-10 mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-center gap-12 xl:gap-20 2xl:gap-32">
        <!-- Left Column: Text -->
        <div class="flex-1 text-center lg:text-left flex flex-col items-center lg:items-start w-full z-20">

          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl 2xl:text-[7.5rem] 2xl:leading-[1.05] font-extrabold tracking-tighter max-w-5xl 2xl:max-w-6xl mb-3 sm:mb-6 md:mb-8 2xl:mb-10 bg-clip-text text-transparent bg-gradient-to-b from-foreground to-foreground/50">
            Documentation that tells a story.
          </h1>

          <p class="text-sm sm:text-base md:text-lg lg:text-xl 2xl:text-2xl text-muted-foreground max-w-2xl 2xl:max-w-3xl mb-6 sm:mb-10 md:mb-12 2xl:mb-16 leading-relaxed">
            Stop writing boring walls of text. Showcrate brings your code to life with interactive, dynamic, and beautiful documentation.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 sm:gap-6 w-full sm:w-auto items-center lg:items-start">
            <a href="/auth/signup" class="w-full sm:w-auto">
              <Button size="lg" className="h-12 sm:h-14 2xl:h-16 px-6 sm:px-8 2xl:px-10 text-sm sm:text-base 2xl:text-lg w-full sm:w-auto rounded-full">
                Start Writing <ChevronRight className="ml-2 h-4 w-4 2xl:h-5 2xl:w-5" />
              </Button>
            </a>
            <a href="/docs/introduction" class="w-full sm:w-auto">
              <Button variant="outline" size="lg" className="h-12 sm:h-14 2xl:h-16 px-6 sm:px-8 2xl:px-10 text-sm sm:text-base 2xl:text-lg w-full sm:w-auto rounded-full bg-background/50 backdrop-blur-sm">
                Explore Docs
              </Button>
            </a>
          </div>
        </div>

        <!-- Right Column: Technical Blueprint Mockup -->
        <div class="flex-1 w-full hidden lg:block relative z-10 mt-10 lg:mt-0 2xl:pl-10">
          <div class="relative w-full max-w-xl xl:max-w-2xl 2xl:max-w-4xl mx-auto transition-transform duration-500 hover:-translate-y-2">

            <!-- Brutalist Shadow Offset -->
            <div class="absolute inset-0 translate-x-4 translate-y-4 bg-primary border-2 border-foreground z-[-1] rounded-sm hidden sm:block"></div>

            <!-- Main Technical Container -->
            <div class="relative bg-background border-2 border-foreground rounded-sm overflow-hidden flex flex-col h-full shadow-2xl">

              <!-- Technical Header -->
              <div class="flex items-center justify-between px-4 py-3 border-b-2 border-foreground bg-muted/40">
                <div class="flex items-center gap-4">
                  <span class="text-xs font-mono uppercase tracking-widest text-foreground font-bold flex items-center gap-2">
                    <span class="w-2 h-2 bg-primary"></span>
                    Showcrate Preview
                  </span>
                  <div class="hidden sm:block h-4 w-px bg-foreground/30"></div>
                  <span class="hidden sm:block text-[10px] font-mono text-muted-foreground uppercase bg-foreground/5 px-2 py-0.5 border border-foreground/20 rounded-sm">Live Environment</span>
                </div>
                <div class="flex gap-1.5">
                  <div class="w-3 h-3 bg-background border border-foreground rounded-sm"></div>
                  <div class="w-3 h-3 bg-foreground border border-foreground rounded-sm"></div>
                </div>
              </div>

              <!-- Content Grid Layout -->
              <div class="flex flex-col md:flex-row h-auto min-h-[380px] divide-y-2 md:divide-y-0 md:divide-x-2 divide-foreground">

                <!-- Left: Markdown Source -->
                <div class="flex-1 bg-muted/10 p-0 flex flex-col relative group">
                  <div class="absolute top-0 right-0 bg-primary text-primary-foreground text-[10px] font-mono font-bold px-2 py-1 border-b-2 border-l-2 border-foreground">src/demo.md</div>
                  <div class="w-full h-full p-6 pt-10 text-xs sm:text-sm font-mono leading-relaxed text-foreground/90 overflow-hidden">
<pre><code><span class="text-muted-foreground"># Button</span>

Try it out.

<span class="text-primary/70">```jsx</span>
import &#123; Button &#125; from "showcrate";

&lt;Button&gt;Interact&lt;/Button&gt;
<span class="text-primary/70">```</span>
</code></pre>
                  </div>
                </div>

                <!-- Right: Rendered Output -->
                <div class="flex-1 bg-[linear-gradient(to_right,#80808020_1px,transparent_1px),linear-gradient(to_bottom,#80808020_1px,transparent_1px)] bg-[size:16px_16px] relative flex flex-col">
                  <div class="absolute top-0 left-0 bg-foreground text-background text-[10px] font-mono font-bold px-2 py-1 uppercase border-b-2 border-r-2 border-foreground">Output</div>

                  <div class="flex-1 flex flex-col p-6 pt-10 gap-4 text-left">
                    <h1 class="text-2xl font-bold tracking-tight text-foreground border-b-2 border-foreground/10 pb-2">Button</h1>

                    <p class="text-sm text-foreground/80 font-medium">Try it out.</p>

                    <!-- Brutalist Button Demo Container -->
                    <div class="mt-2 p-8 border-2 border-dashed border-foreground/30 bg-muted/20 rounded-sm flex items-center justify-center">
                      <!-- Brutalist Button Demo -->
                      <button class="relative group/btn cursor-pointer outline-none w-full max-w-[200px]">
                        <div class="absolute inset-0 translate-x-1.5 translate-y-1.5 bg-foreground transition-transform group-active/btn:translate-x-0 group-active/btn:translate-y-0 rounded-sm"></div>
                        <div class="relative px-6 py-4 bg-primary border-2 border-foreground text-primary-foreground font-mono font-bold text-sm tracking-wider uppercase rounded-sm transition-transform group-active/btn:translate-x-1.5 group-active/btn:translate-y-1.5 flex justify-center">
                          Interact
                        </div>
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Status Bar -->
              <div class="flex items-center justify-between px-4 py-2 border-t-2 border-foreground bg-muted/40 text-[10px] sm:text-xs font-mono uppercase tracking-wider text-muted-foreground">
                <div class="flex items-center gap-2 font-bold text-foreground">
                  <span class="w-2.5 h-2.5 bg-green-500 animate-pulse border border-green-700"></span>
                  Ready
                </div>
                <div class="hidden sm:block">Server: WebContainer</div>
                <div>Port: 3000</div>
              </div>

            </div>
          </div>
        </div>
      </div>

      <!-- Decorative blurry glowing orbs -->
      <div class="absolute top-1/4 left-1/4 w-48 h-48 sm:w-64 sm:h-64 md:w-72 md:h-72 lg:w-96 lg:h-96 bg-primary/30 rounded-full blur-[100px] -z-10 animate-pulse mix-blend-screen"></div>
      <div class="absolute bottom-1/4 right-1/4 w-64 h-64 sm:w-80 sm:h-80 md:w-96 md:h-96 lg:w-[32rem] lg:h-[32rem] bg-primary/20 rounded-full blur-[120px] -z-10 mix-blend-screen"></div>
    </section>

    <!-- ========================================== -->
    <!-- 2. PROBLEM SECTION                         -->
    <!-- "Most documentation feels like a graveyard"-->
    <!-- ========================================== -->
    <div id="problem-section">
        
    </div>

    <!-- ========================================== -->
    <!-- 3. SOLUTION SECTION                        -->
    <!-- "Bring your code to life" features         -->
    <!-- ========================================== -->
    <div id="solution-section">

    </div>
    
    <!-- ========================================== -->
    <!-- 4. INTERACTIVE EDITOR MOCKUP               -->
    <!-- Live typing and rendering demonstration    -->
    <!-- ========================================== -->
    <section id="editor-mockup-container" class="relative z-10 w-full min-h-screen bg-background flex flex-col items-center justify-center py-16">
      <div class="w-full max-w-7xl 2xl:max-w-[1700px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="editor-window opacity-0 translate-y-12 scale-95 relative w-full max-w-6xl mx-auto">
          <div class="absolute inset-0 bg-gradient-to-r from-primary to-secondary blur-3xl opacity-20 rounded-full"></div>
          <div class="relative rounded-2xl border border-border bg-background/80 backdrop-blur-xl shadow-2xl overflow-hidden flex flex-col group hover:border-primary/50 transition-colors duration-500">

            <!-- Window Header -->
            <div class="flex items-center justify-between px-4 py-2.5 border-b border-border/80 bg-muted/20 backdrop-blur-md">
              <!-- Left: Window Controls -->
              <div class="flex items-center gap-4">
                <div class="flex gap-1.5 sm:gap-2">
                  <div class="h-2.5 w-2.5 sm:h-3 sm:w-3 rounded-full bg-[#FF5F56] border border-[#E0443E]"></div>
                  <div class="h-2.5 w-2.5 sm:h-3 sm:w-3 rounded-full bg-[#FFBD2E] border border-[#DEA123]"></div>
                  <div class="h-2.5 w-2.5 sm:h-3 sm:w-3 rounded-full bg-[#27C93F] border border-[#1AAB29]"></div>
                </div>

                <!-- File Path / Breadcrumb -->
                <div class="hidden sm:flex items-center text-[11px] text-muted-foreground font-mono bg-background/50 px-2 py-1 rounded-md border border-border/50 shadow-inner select-none">
                  <svg class="w-3 h-3 mr-1.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
                  showcrate<span class="mx-1.5 text-border">/</span><span class="text-foreground">README.md</span>
                </div>
              </div>

              <!-- Right: Status / Actions -->
              <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5 text-[10px] sm:text-[11px] font-bold tracking-wide uppercase text-success bg-success/10 border border-success/20 px-2.5 py-1 rounded-full select-none">
                  <span class="relative flex h-1.5 w-1.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-success"></span>
                  </span>
                  Live
                </div>
                <a href="/editor" class="flex relative z-50 items-center gap-1.5 h-6 px-2.5 rounded-md bg-primary/10 hover:bg-primary/20 text-primary transition-colors cursor-pointer group" title="Open in Full Screen">
                  <span class="text-[10px] font-bold uppercase tracking-wider group-hover:text-primary transition-colors">Open Editor</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </a>
              </div>
            </div>

            <!-- Mobile Tabs -->
            <div class="sm:hidden flex border-b border-border/80 bg-card">
              <button id="tab-code" class="flex-1 py-3 text-xs font-bold border-b-2 border-primary text-foreground transition-colors uppercase tracking-widest">Editor</button>
              <button id="tab-preview" class="flex-1 py-3 text-xs font-bold border-b-2 border-transparent text-muted-foreground transition-colors uppercase tracking-widest">Preview</button>
            </div>

            <!-- Split Content -->
            <div class="grid grid-cols-1 sm:grid-cols-5 divide-y sm:divide-y-0 sm:divide-x divide-border/80">

              <!-- Left: Editor Pane (3/5 width) -->
              <div id="pane-code" class="sm:col-span-3 bg-card/40 p-0 overflow-hidden min-h-[250px] sm:min-h-[350px] flex flex-col font-mono text-sm relative group/editor border-r border-transparent focus-within:border-primary/50 transition-colors">
                <textarea id="interactive-editor" class="w-full h-full min-h-[250px] sm:min-h-[350px] p-4 sm:p-6 bg-transparent text-primary/80 focus:text-primary whitespace-pre-wrap leading-relaxed outline-none resize-none z-10 font-mono placeholder:text-muted-foreground/50 transition-colors" spellcheck="false" placeholder="Type some markdown here..."></textarea>
                <!-- Edit Badge -->
                <div class="absolute top-4 right-4 bg-primary/20 text-primary text-[10px] uppercase font-bold px-2 py-1 rounded opacity-50 group-focus-within/editor:opacity-100 transition-opacity pointer-events-none z-20">
                  Editable
                </div>
              </div>

              <!-- Right: Preview Pane (2/5 width) -->
              <div id="pane-preview" class="hidden sm:flex sm:col-span-2 bg-background flex-col items-center justify-center p-6 min-h-[250px] sm:min-h-[350px] relative overflow-hidden">
                <!-- Subtle grid background for the preview -->
                <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:12px_12px]"></div>

                <div id="typewriter-preview" class="relative z-10 text-left flex flex-col w-full h-full border border-dashed border-primary/20 rounded-lg bg-card/30 p-4 overflow-y-auto">
                  <!-- Live preview content injected here -->
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- 5. FEATURES GRID SECTION                   -->
    <!-- Secondary features (MDX, SSG, etc.)        -->
    <!-- ========================================== -->
    <section id="features-grid" class="relative py-24 sm:py-32 bg-background overflow-hidden border-t border-border/50">
      <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">

        <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-24">
          <h2 class="type-animate text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-6 text-foreground">Built for the modern web</h2>
          <p class="type-animate text-lg sm:text-xl text-muted-foreground">Everything you need to build interactive documentation that your users will actually love reading.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 relative z-20">

          <!-- Feature 1 -->
          <div class="feature-card-fade opacity-0 translate-y-12 relative group rounded-3xl border border-border/50 bg-card/50 backdrop-blur-sm overflow-hidden hover:border-primary/50 transition-colors duration-500">
            <!-- Premium top glow -->
            <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent"></div>
            <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

            <div class="p-8 sm:p-10 h-full flex flex-col relative z-10">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-primary/20 to-primary/5 flex items-center justify-center mb-8 border border-primary/20 shadow-[0_0_30px_rgba(var(--color-primary),0.2)] group-hover:shadow-[0_0_40px_rgba(var(--color-primary),0.4)] transition-shadow duration-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="m8 3 4 8 5-5 5 15H2L8 3z"/></svg>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold mb-4 text-foreground tracking-tight">Markdown to MDX</h3>
              <p class="text-muted-foreground leading-relaxed flex-1">Write your documentation in standard Markdown. Showcrate effortlessly compiles it into interactive MDX, unlocking live components directly within your text.</p>
            </div>
          </div>

          <!-- Feature 2 -->
          <div class="feature-card-fade opacity-0 translate-y-12 relative group rounded-3xl border border-border/50 bg-card/50 backdrop-blur-sm overflow-hidden hover:border-emerald-500/50 transition-colors duration-500">
            <!-- Premium top glow -->
            <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-emerald-500/30 to-transparent"></div>
            <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

            <div class="p-8 sm:p-10 h-full flex flex-col relative z-10">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-500/20 to-emerald-500/5 flex items-center justify-center mb-8 border border-emerald-500/20 shadow-[0_0_30px_rgba(16,185,129,0.2)] group-hover:shadow-[0_0_40px_rgba(16,185,129,0.4)] transition-shadow duration-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold mb-4 text-foreground tracking-tight">Built-in Code Editor</h3>
              <p class="text-muted-foreground leading-relaxed flex-1">Give your users a fully featured code editor right in the browser. They can tinker, break, and fix your examples in a safe, live environment.</p>
            </div>
          </div>

          <!-- Feature 3 -->
          <div class="feature-card-fade opacity-0 translate-y-12 relative group rounded-3xl border border-border/50 bg-card/50 backdrop-blur-sm overflow-hidden hover:border-indigo-500/50 transition-colors duration-500">
            <!-- Premium top glow -->
            <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-indigo-500/30 to-transparent"></div>
            <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

            <div class="p-8 sm:p-10 h-full flex flex-col relative z-10">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-indigo-500/20 to-indigo-500/5 flex items-center justify-center mb-8 border border-indigo-500/20 shadow-[0_0_30px_rgba(99,102,241,0.2)] group-hover:shadow-[0_0_40px_rgba(99,102,241,0.4)] transition-shadow duration-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold mb-4 text-foreground tracking-tight">Lightning Fast SSG</h3>
              <p class="text-muted-foreground leading-relaxed flex-1">Powered by Astro, Showcrate generates incredibly fast static sites. Your interactive documentation loads instantly and is perfectly optimized for SEO.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- 6. CALL TO ACTION (CTA) SECTION            -->
    <!-- Final push to sign up or read docs         -->
    <!-- ========================================== -->
    <section id="cta-section" class="relative py-24 sm:py-32 md:py-40 lg:py-48 overflow-hidden border-t border-border/50">
      <!-- Background Glows -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-primary/20 blur-[120px] rounded-full pointer-events-none"></div>

      <!-- Subtle Grid -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>

      <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-4xl flex flex-col items-center">
        <!-- Social Proof Badge -->
        <div class="cta-badge-anim opacity-0 translate-y-8 inline-flex items-center gap-3 px-4 py-2 rounded-full bg-card/80 border border-border/50 backdrop-blur-md mb-8 shadow-sm overflow-hidden min-w-[260px] justify-start">
          <div class="flex -space-x-2 shrink-0">
            <div class="badge-avatar opacity-0 translate-x-12 w-7 h-7 rounded-full bg-gradient-to-br from-blue-400 to-indigo-500 border-2 border-background z-40 relative"></div>
            <div class="badge-avatar opacity-0 translate-x-12 w-7 h-7 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 border-2 border-background z-30 relative"></div>
            <div class="badge-avatar opacity-0 translate-x-12 w-7 h-7 rounded-full bg-gradient-to-br from-amber-400 to-orange-500 border-2 border-background z-20 relative"></div>
            <div class="badge-avatar opacity-0 translate-x-12 w-7 h-7 rounded-full bg-gradient-to-br from-purple-400 to-pink-500 border-2 border-background z-10 relative flex items-center justify-center text-[10px] font-bold text-white">+</div>
          </div>
          <div class="badge-typing w-0 overflow-hidden border-r-2 border-primary whitespace-nowrap flex items-center">
            <span class="text-xs font-semibold text-muted-foreground pr-1">Joined by 1,000+ developers</span>
          </div>
        </div>

        <h2 class="cta-fade-in opacity-0 translate-y-8 text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold mb-6 sm:mb-8 tracking-tight text-balance">
          Ready to rewrite the rules?
        </h2>
        <p class="cta-fade-in opacity-0 translate-y-8 text-lg sm:text-xl md:text-2xl text-muted-foreground mb-10 sm:mb-12 max-w-2xl text-balance">
          Stop writing static documentation that goes out of date. Build live, interactive learning experiences in minutes.
        </p>

        <div class="cta-fade-in opacity-0 translate-y-8 flex flex-col sm:flex-row items-center gap-4 sm:gap-6 w-full sm:w-auto">
          <a href="/auth/signup" class="w-full sm:w-auto">
            <Button size="lg" className="w-full sm:w-auto h-14 sm:h-16 px-8 sm:px-12 text-base sm:text-lg rounded-full font-bold shadow-xl shadow-primary/25 hover:scale-105 hover:shadow-primary/40 transition-all duration-300">
              Start for free
            </Button>
          </a>
          <a href="/docs" class="w-full sm:w-auto">
            <Button variant="outline" size="lg" className="w-full sm:w-auto h-14 sm:h-16 px-8 sm:px-10 text-base sm:text-lg rounded-full font-bold border-2 hover:bg-muted transition-colors duration-300">
              Read the docs
            </Button>
          </a>
        </div>
      </div>
    </section>
  </div>
</LandingLayout>

<script>
  /**
   * ==========================================
   * 1. IMPORTS & SETUP
   * ==========================================
   */
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Sync GSAP with Lenis for perfectly smooth scrubbing
  if (typeof window !== 'undefined' && (window as any).lenis) {
    (window as any).lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => {
      (window as any).lenis.raf(time * 1000);
    });
    gsap.ticker.lagSmoothing(0);
  }

  let mm = gsap.matchMedia();

  /**
   * ==========================================
   * 2. SCROLL ANIMATIONS (GSAP)
   * ==========================================
   */
  mm.add({
    isDesktop: "(min-width: 768px)",
    isMobile: "(max-width: 767px)"
  }, (context) => {
    let { isMobile } = context.conditions as { isDesktop: boolean, isMobile: boolean };

    // 1. Parallax Hero Section
    gsap.to('#hero-section .container', {
      y: isMobile ? 80 : 150, // Less parallax on mobile
      opacity: 0,
      ease: 'none',
      scrollTrigger: {
        trigger: '#hero-section',
        start: 'top top',
        end: 'bottom top',
        scrub: true,
      },
    });

    // 2. Story Section 1: Sequenced Word-by-Word Reveal
    const tl1 = gsap.timeline({
      scrollTrigger: {
        trigger: '#problem-section',
        start: 'top top',
        end: '+=' + (window.innerHeight * (isMobile ? 1.5 : 2)), // Shorter scroll distance on mobile
        scrub: 1,
      }
    });

    tl1.to('.story-word', { opacity: 1, y: 0, stagger: 0.1, ease: 'power2.out' })
       .to('.story-word-sub', { opacity: 1, y: 0, stagger: 0.05, ease: 'power2.out' }, "+=1");

    // Story Section 2: Sequenced Component Fade In
    const tl2 = gsap.timeline({
      scrollTrigger: {
        trigger: '#solution-section',
        start: 'top top',
        end: '+=' + (window.innerHeight * (isMobile ? 1.5 : 2.5)), // Shorter scroll distance on mobile
        scrub: 1,
      }
    });

    tl2.to('.interactive-icon-anim', { opacity: 1, y: 0, duration: 1 })
       .to('.interactive-icon-anim', { x: 0, duration: 1 }, "+=0.5")
       .to('.interactive-text-anim', { opacity: 1, x: 0, duration: 1 }, "<")
       .to('.solution-fade-in', {
      opacity: 1,
      y: 0,
      stagger: 0.2,
      ease: 'power2.out',
      duration: 1
    }, "+=0.2");

    // Animation: Scale up and fade in window
    gsap.to('.editor-window', {
      opacity: 1,
      y: 0,
      scale: 1,
      ease: 'power3.out',
      duration: 1,
      scrollTrigger: {
        trigger: '#editor-mockup-container',
        start: isMobile ? 'top 80%' : 'top 60%',
      }
    });

    // Split text into spans for typing animation
    document.querySelectorAll('.type-animate').forEach((el: any) => {
      const text = el.innerText;
      el.innerHTML = '';
      // Enable pre-wrap so normal spaces render but standard wrapping is preserved
      el.style.whiteSpace = 'pre-wrap';
      text.split('').forEach((char: string) => {
        const span = document.createElement('span');
        span.textContent = char;
        span.style.opacity = '0';
        el.appendChild(span);
      });
    });

    // Features Header Typing Animation
    gsap.to('.type-animate span', {
      opacity: 1,
      stagger: 0.03, // Type out each letter
      ease: 'none',
      scrollTrigger: {
        trigger: '#features-grid',
        start: isMobile ? 'top 90%' : 'top 80%',
      }
    });

    // Slower Feature Cards
    gsap.fromTo('.feature-card-fade',
      { opacity: 0, y: 40, scale: 0.95 },
      {
        opacity: 1,
        y: 0,
        scale: 1,
        stagger: 0.3, // Slower stagger
        duration: 1.5, // Longer duration
        ease: 'back.out(1.2)',
        scrollTrigger: {
          trigger: '#features-grid',
          start: isMobile ? 'top 85%' : 'top 70%',
        }
      }
    );

    // CTA Section Fade In (Scrubbing individually)
    gsap.utils.toArray('.cta-fade-in').forEach((el: any) => {
      gsap.to(el, {
        opacity: 1,
        y: 0,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 100%',
          end: isMobile ? 'top 50%' : 'top 30%',
          scrub: 1,
        }
      });
    });

    // Social Proof Badge Custom Timeline
    const badgeTl = gsap.timeline({
      scrollTrigger: {
        trigger: '#cta-section',
        start: 'top 95%',
        end: isMobile ? 'top 50%' : 'top 35%',
        scrub: 1,
      }
    });

    badgeTl.to('.cta-badge-anim', { opacity: 1, y: 0, duration: 1 })
           .to('.badge-avatar', { opacity: 1, x: 0, stagger: 0.2, ease: 'power2.out', duration: 1.5 }, "+=0.2")
           .to('.badge-typing', { width: 'auto', ease: 'none', duration: 1.5 }, "+=0.2")
           .to('.badge-typing', { borderRightColor: 'transparent', duration: 0.2 });

  }); // End matchMedia

  /**
   * ==========================================
   * 3. INTERACTIVE LIVE EDITOR LOGIC
   * ==========================================
   */
  const markdownSource = `# Showcrate

The fastest way to build **live** docs.

> "Just like a README, but interactive."

## Snippets become Workspaces

\`\`\`javascript
import { serve } from "showcrate";

serve(() => new Response("Hello!"));
\`\`\``;

  const editor = document.getElementById('interactive-editor') as HTMLTextAreaElement | null;
  const preview = document.getElementById('typewriter-preview');

  function renderPreview(text: string) {
    if (!preview) return;

    // Extract code blocks first to protect them from other formatting
    const codeBlocks: string[] = [];
    let processedText = text.replace(/```[a-z]*\n([\s\S]*?)\n```/gim, (match, code) => {
      codeBlocks.push(code.replace(/</g, '&lt;').replace(/>/g, '&gt;'));
      return `__CODEBLOCK_${codeBlocks.length - 1}__`;
    });

    // Parse Markdown
    processedText = processedText
      .replace(/^### (.*$)/gim, '<h3 class="text-xl font-bold mt-6 mb-2 text-foreground">$1</h3>')
      .replace(/^## (.*$)/gim, '<h2 class="text-2xl font-bold mt-6 mb-3 text-foreground border-b border-border/30 pb-2">$1</h2>')
      .replace(/^# (.*$)/gim, '<h1 class="text-3xl sm:text-4xl font-extrabold bg-clip-text text-transparent bg-gradient-to-br from-primary to-secondary mb-6 tracking-tight">$1</h1>')
      .replace(/^> (.*$)/gim, '<blockquote class="border-l-4 border-primary pl-4 py-2 italic text-muted-foreground my-4 bg-primary/10 rounded-r-md">$1</blockquote>')
      .replace(/\*\*(.*?)\*\*/gim, '<strong class="text-foreground font-bold">$1</strong>')
      .replace(/`(.*?)`/gim, '<code class="bg-muted px-1.5 py-0.5 rounded text-primary font-mono text-sm border border-border/50">$1</code>')
      .replace(/\n\n/g, '<div class="h-4"></div>') // spacing for double newlines
      .replace(/\n/g, '<br/>'); // replace remaining newlines with br

    // Cleanup extra br tags after block elements
    processedText = processedText
      .replace(/<\/h([1-6])><br\/>/g, '</h$1>')
      .replace(/<\/blockquote><br\/>/g, '</blockquote>')
      .replace(/<\/div><br\/>/g, '</div>');

    // Re-insert code blocks
    codeBlocks.forEach((code, index) => {
      processedText = processedText.replace(`__CODEBLOCK_${index}__`, `<pre class="bg-[#0d1117] text-[#c9d1d9] p-4 rounded-xl border border-border mt-4 mb-6 overflow-x-auto text-xs sm:text-sm font-mono shadow-inner leading-relaxed"><code>${code}</code></pre>`);
    });

    preview.innerHTML = processedText;
  }

  if (editor) {
    let userTookControl = false;

    // Set initial empty state
    editor.value = "";
    renderPreview("");

    // Setup robust vanilla JS typing animation
    const container = document.getElementById('editor-mockup-container');
    if (container) {
      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting && !userTookControl) {
          let i = 0;
          // ~4 seconds total for the string length
          const speed = Math.max(20, Math.floor(4000 / markdownSource.length));

          const typeWriter = setInterval(() => {
            if (userTookControl || i >= markdownSource.length) {
              clearInterval(typeWriter);
              return;
            }
            editor.value = markdownSource.substring(0, i + 1);
            editor.scrollTop = editor.scrollHeight;
            renderPreview(editor.value);
            i++;
          }, speed);

          observer.disconnect(); // Only run once
        }
      }, { threshold: 0.4 }); // Trigger when 40% of the container is visible

      observer.observe(container);
    }

    // Stop animation if user interacts
    editor.addEventListener('focus', (e) => {
      if (!e.isTrusted) return;
      userTookControl = true;
    });

    editor.addEventListener('input', (e) => {
      if (!e.isTrusted) return;
      userTookControl = true;
      renderPreview((e.target as HTMLTextAreaElement).value);
    });
  }

  /**
   * ==========================================
   * 4. MOBILE TABS LOGIC
   * ==========================================
   */
  const tabCode = document.getElementById('tab-code');
  const tabPreview = document.getElementById('tab-preview');
  const paneCode = document.getElementById('pane-code');
  const panePreview = document.getElementById('pane-preview');

  if (tabCode && tabPreview && paneCode && panePreview) {
    tabCode.addEventListener('click', () => {
      paneCode.classList.remove('hidden');
      paneCode.classList.add('flex');
      panePreview.classList.add('hidden');
      panePreview.classList.remove('flex');

      tabCode.classList.replace('border-transparent', 'border-primary');
      tabCode.classList.replace('text-muted-foreground', 'text-foreground');
      tabPreview.classList.replace('border-primary', 'border-transparent');
      tabPreview.classList.replace('text-foreground', 'text-muted-foreground');
    });

    tabPreview.addEventListener('click', () => {
      panePreview.classList.remove('hidden');
      panePreview.classList.add('flex');
      paneCode.classList.add('hidden');
      paneCode.classList.remove('flex');

      tabPreview.classList.replace('border-transparent', 'border-primary');
      tabPreview.classList.replace('text-muted-foreground', 'text-foreground');
      tabCode.classList.replace('border-primary', 'border-transparent');
      tabCode.classList.replace('text-foreground', 'text-muted-foreground');
    });
  }
</script>
