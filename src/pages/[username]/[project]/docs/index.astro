---
// src/pages/[username]/[project]/docs/index.astro
// Serves the project index documentation page at /[username]/[project]/docs
import DocsLayout from '@/layouts/Docs.astro';
import { createServerClient } from '@/lib/supabase/server';
import { renderMarkdown } from '@/lib/render-markdown';

const { username, project: projectSlug } = Astro.params;

if (!username || !projectSlug) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const supabase = createServerClient(Astro.cookies);
const viewer = Astro.locals.viewer ?? Astro.locals.user;

// 1. Resolve project
let project = Astro.locals.project;
let isOwner = Boolean(Astro.locals.isOwner);

if (!project) {
  const { data: ownerUser } = await supabase
    .from('users')
    .select('id, username')
    .ilike('username', username)
    .single();

  if (!ownerUser) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
  }

  const { data: projectRow } = await supabase
    .from('projects')
    .select('*')
    .eq('owner_id', ownerUser.id)
    .eq('slug', projectSlug)
    .is('deleted_at', null)
    .single();

  if (!projectRow) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
  }

  project = projectRow;
  isOwner = viewer?.id === project.owner_id;
}

// Access check: private or draft projects return 404 to non-owners
if ((project.visibility === 'private' || !project.published) && !isOwner) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// 2. Fetch the index doc page
const { data: indexPage } = await supabase
  .from('doc_pages')
  .select('id, title, content, is_index, slug')
  .eq('project_id', project.id)
  .eq('is_index', true)
  .eq('kind', 'page')
  .is('deleted_at', null)
  .single();

let activePage = indexPage;

if (!activePage) {
  // Fallback to first page by order_index
  const { data: firstPage } = await supabase
    .from('doc_pages')
    .select('id, title, content, is_index, slug')
    .eq('project_id', project.id)
    .eq('kind', 'page')
    .is('deleted_at', null)
    .order('order_index', { ascending: true })
    .limit(1)
    .single();

  activePage = firstPage;
}

if (!activePage) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// 3. Query tree: Never select content for the tree query
const { data: treeNodes } = await supabase
  .from('doc_pages')
  .select('id, parent_id, kind, title, slug, order_index, is_index')
  .eq('project_id', project.id)
  .is('deleted_at', null)
  .order('order_index', { ascending: true });

// 4. Render markdown content
const html = await renderMarkdown(activePage.content ?? '');
---

<DocsLayout
  project={project}
  owner={{ username }}
  currentPage={activePage}
  treeNodes={treeNodes ?? []}
  isOwner={isOwner}
>
  <div set:html={html} />
</DocsLayout>
