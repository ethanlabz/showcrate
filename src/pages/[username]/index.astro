---
import HomeLayout from '@/layouts/HomeLayout.astro';
import { createServerClient } from '@/lib/supabase/server';
import { isReservedUsername } from '@/lib/validators/auth.schema';
import { Button } from '@/components/ui/button';
import { FolderKanban, Settings, ExternalLink } from 'lucide-react';

import {
  resolveCanonical,
  createSupabaseCanonicalAdapter,
} from '@/lib/routing/resolve-canonical';

const { username } = Astro.params;

if (!username || isReservedUsername(username)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const supabase = createServerClient(Astro.cookies);
const adapter = createSupabaseCanonicalAdapter(supabase);
const canonical = await resolveCanonical(username, undefined, adapter);

if (canonical.status === 'notfound') {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

if (canonical.status === 'redirect') {
  return Astro.redirect(canonical.location, 301);
}

const viewer = Astro.locals.viewer ?? Astro.locals.user;
const isSelf = viewer?.id === canonical.ownerId;

// 2. Query user profile
const { data: profileUser } = await supabase
  .from('users')
  .select('id, username, display_name, avatar_url, bio, created_at')
  .eq('id', canonical.ownerId)
  .single();

if (!profileUser) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// 3. Query public published projects
let projectsQuery = supabase
  .from('projects')
  .select('id, name, slug, tagline, visibility, published, updated_at')
  .eq('owner_id', profileUser.id)
  .is('deleted_at', null);

if (!isSelf) {
  projectsQuery = projectsQuery.eq('published', true).eq('visibility', 'public');
}

const { data: projects } = await projectsQuery.order('updated_at', { ascending: false });

const displayName = profileUser.display_name || profileUser.username;
const avatarUrl = profileUser.avatar_url || `https://api.dicebear.com/10.x/shapes/svg?seed=${profileUser.username}`;
---

<HomeLayout title={`@${profileUser.username} — Showcrate`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <!-- User Profile Header -->
    <div class="flex flex-col sm:flex-row items-start justify-between gap-6 pb-8 border-b border-border/40 mb-10">
      <div class="flex items-start gap-4">
        <img
          src={avatarUrl}
          alt={displayName}
          class="h-16 w-16 sm:h-20 sm:w-20 rounded-2xl border border-border object-cover bg-surface"
        />
        <div>
          <h1 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
            {displayName}
          </h1>
          <p class="text-sm font-mono text-muted-foreground mt-0.5">
            @{profileUser.username}
          </p>
          {profileUser.bio && (
            <p class="text-xs text-muted-foreground mt-3 max-w-lg leading-relaxed">
              {profileUser.bio}
            </p>
          )}
        </div>
      </div>

      {isSelf && (
        <a href="/dashboard/settings/profile">
          <Button variant="outline" size="sm" className="gap-1.5 text-xs">
            <Settings className="h-3.5 w-3.5" />
            <span>Edit profile</span>
          </Button>
        </a>
      )}
    </div>

    <!-- Projects Section -->
    <div class="space-y-4">
      <h2 class="font-serif text-lg font-semibold text-foreground flex items-center gap-2">
        <FolderKanban className="h-4 w-4 text-[#C9A96A]" />
        <span>Projects</span>
        <span class="text-xs font-mono text-muted-foreground">({projects?.length ?? 0})</span>
      </h2>

      {projects && projects.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {projects.map((p: any) => (
            <div class="rounded-xl border border-border/50 bg-surface/30 p-5 flex flex-col justify-between hover:border-[#C9A96A]/40 transition-colors">
              <div>
                <h3 class="font-serif font-bold text-base text-foreground mb-1">
                  {p.name}
                </h3>
                {p.tagline && (
                  <p class="text-xs text-muted-foreground line-clamp-2 mb-4">
                    {p.tagline}
                  </p>
                )}
              </div>

              <div class="pt-4 border-t border-border/40 flex items-center justify-between text-xs">
                <a
                  href={`/${profileUser.username}/${p.slug}`}
                  class="flex items-center gap-1 text-[#C9A96A] hover:underline font-medium"
                >
                  <span>View project</span>
                  <ExternalLink className="h-3 w-3" />
                </a>

                {isSelf && (
                  <a
                    href={`/dashboard/projects/${p.id}/editor`}
                    class="text-xs text-muted-foreground hover:text-foreground"
                  >
                    Edit in dashboard
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="rounded-xl border border-dashed border-border/60 p-12 text-center bg-surface/20 text-xs text-muted-foreground">
          No public projects yet.
        </div>
      )}
    </div>
  </div>
</HomeLayout>
