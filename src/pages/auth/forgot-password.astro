---
import AuthLayout from '@/layouts/AuthLayout.astro';
import ForgotPasswordForm from '@/components/auth/ForgotPasswordForm';

// Redirect logged-in users away
if (Astro.locals.user) {
  return Astro.redirect('/');
}
---

<AuthLayout title="Reset password">
  <div class="flex flex-col gap-6">
    <div class="flex flex-col gap-1">
      <h1 class="text-2xl font-heading font-semibold tracking-tight text-foreground">
        Forgot your password?
      </h1>
      <p class="text-sm text-muted-foreground">
        Enter your email and we'll send you a reset link.
      </p>
    </div>

    <ForgotPasswordForm client:load />

    <p class="text-center text-sm text-muted-foreground">
      Remember it?{' '}
      <a href="/auth/login" class="font-medium text-foreground underline underline-offset-2 hover:opacity-80 transition-opacity">
        Back to sign in
      </a>
    </p>
  </div>
</AuthLayout>
