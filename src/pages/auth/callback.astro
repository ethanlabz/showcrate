---
/**
 * auth/callback.astro — OAuth callback handler
 *
 * After the user authenticates with GitHub/Google, Supabase redirects
 * here with a `code` query param. We exchange it for a session (which
 * sets the auth cookies).
 *
 * - Returning OAuth user (already has a username) → redirect to `next`.
 * - New OAuth user (no username yet) → upsert a skeleton profile row
 *   (display_name + avatar_url, no username) then redirect to
 *   /auth/signup?social=true so the user can pick their own username.
 */
import { createServerClient } from '@/lib/supabase/server';

const supabase = createServerClient(Astro.cookies);

const code = Astro.url.searchParams.get('code');
const next = Astro.url.searchParams.get('next') || '/';

if (!code) {
  return Astro.redirect('/auth/login?error=missing_code');
}

// Exchange the code for a session — sets auth cookies via @supabase/ssr
const { data: sessionData, error: sessionError } =
  await supabase.auth.exchangeCodeForSession(code);

if (sessionError || !sessionData?.user) {
  console.error('[auth/callback] Session exchange failed:', sessionError?.message);
  return Astro.redirect('/auth/login?error=oauth_failed');
}

const user = sessionData.user;

// Check if this user already has a username (returning OAuth user)
const { data: profile } = await supabase
  .from('users')
  .select('username')
  .eq('id', user.id)
  .single();

if (profile?.username) {
  // Returning user — straight to destination
  return Astro.redirect(next);
}

// ── New OAuth user ────────────────────────────────────────────────────────────
// Build display info from provider metadata (stored by Supabase)
const meta = user.user_metadata ?? {};
const displayName = meta.full_name || meta.name || meta.preferred_username || null;
const avatarUrl = meta.avatar_url || meta.picture || null;

// Upsert a skeleton profile row so the middleware can resolve locals.user
// on the next request. Username is intentionally left null — the user will
// choose it on /auth/signup?social=true.
await supabase
  .from('users')
  .upsert(
    { id: user.id, display_name: displayName, avatar_url: avatarUrl },
    { onConflict: 'id' },
  );

// Build a clean suggested username slug from provider metadata:
//   GitHub  → preferred_username (their actual GH handle)
//   Google  → name slugified
// The suggestion may or may not already be taken — the form validates live.
const rawSuggestion =
  meta.preferred_username ||
  meta.user_name ||
  (meta.full_name || meta.name || '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
    .replace(/-{2,}/g, '-') ||
  'user';

const suggested = rawSuggestion.slice(0, 39);

return Astro.redirect(
  `/auth/signup?social=true&suggested=${encodeURIComponent(suggested)}&next=${encodeURIComponent(next)}`,
);
---
