---
import AuthLayout from '@/layouts/AuthLayout.astro';
import ResetPasswordForm from '@/components/auth/ResetPasswordForm';

// If user is already authenticated (not via recovery), send them home
// Note: We do NOT redirect if there is a session — the recovery flow
// itself establishes a temporary session, and the user needs this page
// to set their new password.
---

<AuthLayout title="Set new password">
  <div class="flex flex-col gap-6">
    <div class="flex flex-col gap-1">
      <h1 class="text-2xl font-heading font-semibold tracking-tight text-foreground">
        Set new password
      </h1>
      <p class="text-sm text-muted-foreground">
        Choose a strong password for your account.
      </p>
    </div>

    <ResetPasswordForm client:load />
  </div>
</AuthLayout>
