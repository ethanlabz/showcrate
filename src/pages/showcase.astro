---
import LandingLayout from '@/layouts/HomeLayout.astro';
import ScrollReveal from '@/components/animations/ScrollReveal';
import { Button } from '@/components/ui/button';
import { ShowcaseDirectory } from '@/components/pages/home/showcase-directory';
---

<LandingLayout title='Showcase'>
  <div class='relative min-h-screen overflow-hidden pb-24 sm:pb-32'>
    <!-- Ambient background -->
    <div
      aria-hidden='true'
      class='pointer-events-none absolute left-1/2 top-0 h-112 w-4xl max-w-full -translate-x-1/2 -translate-y-1/3 rounded-full bg-primary/15 blur-3xl'
    >
    </div>

    <div
      class='container relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8'
    >
      <ShowcaseDirectory client:load />

      <!-- CTA -->
      <ScrollReveal
        client:load
        distance={32}
        scale={0.97}
        duration={0.9}
        className='relative mt-24 overflow-hidden rounded-3xl border border-border/60 bg-card/50 px-6 py-14 text-center sm:mt-32 sm:px-12 sm:py-20'
      >
        <div
          aria-hidden='true'
          class='pointer-events-none absolute left-1/2 top-0 h-56 w-[32rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/20 blur-3xl'
        >
        </div>

        <div class='relative flex flex-col items-center'>
          <h2
            class='font-display text-3xl font-bold tracking-tight text-balance sm:text-4xl'
          >
            Want to be featured?
          </h2>
          <p
            class='mt-4 max-w-xl text-muted-foreground text-balance sm:text-lg'
          >
            Build something with Showcrate and submit it. We'd love to put your
            work on the showcase.
          </p>
          <a href='/dashboard' class='mt-8'>
            <Button size='lg' className='h-12 px-8'>Submit your project</Button>
          </a>
        </div>
      </ScrollReveal>
    </div>
  </div>
</LandingLayout>