---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { GradientHeading } from "@/components/public/GradientHeading";
import { PricingTable } from "@/components/public/PricingTable";
---

<PublicLayout title="Pricing | Showcrate">
  <div class="relative overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[600px] bg-primary/20 blur-[150px] rounded-full -z-10 pointer-events-none"></div>
    
    <div class="container mx-auto px-4 py-24 sm:px-6 lg:px-8">
      <GradientHeading 
        title="Simple, transparent pricing" 
        subtitle="Choose the perfect plan for your needs. Always know what you'll pay."
      />

      <div class="mt-8">
        <PricingTable client:load />
      </div>
      
      <!-- FAQ Section -->
      <div class="max-w-3xl mx-auto mt-32">
        <h2 class="text-3xl font-bold mb-12 text-center">Frequently asked questions</h2>
        <div class="space-y-8">
          <div>
            <h3 class="text-lg font-bold mb-2">Can I switch plans later?</h3>
            <p class="text-muted-foreground">Absolutely. You can upgrade or downgrade your plan at any time. Prorated charges will be applied automatically.</p>
          </div>
          <div>
            <h3 class="text-lg font-bold mb-2">What happens if I exceed my environment limit?</h3>
            <p class="text-muted-foreground">If you are on the Hobby plan, older environments will be archived. Pro and Enterprise plans have unlimited environments.</p>
          </div>
          <div>
            <h3 class="text-lg font-bold mb-2">Do you offer discounts for open source?</h3>
            <p class="text-muted-foreground">Yes! We love open source. Contact our support team with a link to your project to get a free Pro license.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</PublicLayout>
