---
import LandingLayout from "@/layouts/LandingLayout.astro";
import { ContactForm } from "@/components/pages/public/ContactForm";
import { Mail, MapPin, Phone } from "lucide-react";
---

<LandingLayout title="Contact Us - Showcrate">
  <div class="relative min-h-screen pb-32">
    <!-- Abstract Background -->
    <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-primary/5 to-transparent pointer-events-none"></div>
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary/10 rounded-full blur-[100px] pointer-events-none"></div>
    
    <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8 pt-32 lg:pt-40 max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
        
        <!-- Left Side: Info -->
        <div class="flex flex-col justify-center">
          <h1 class="text-5xl sm:text-6xl font-extrabold tracking-tight mb-6">
            Get in touch
          </h1>
          <p class="text-xl text-muted-foreground leading-relaxed mb-12">
            Whether you have a question about pricing, need help setting up your first workspace, or want to discuss enterprise options, our team is ready to help.
          </p>
          
          <div class="space-y-8">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-card border border-border flex items-center justify-center shrink-0 text-primary shadow-sm">
                <Mail className="w-6 h-6" />
              </div>
              <div>
                <h3 class="text-lg font-bold text-foreground mb-1">Email us</h3>
                <p class="text-muted-foreground mb-1">Our friendly team is here to help.</p>
                <a href="mailto:hello@showcrate.test" class="text-primary hover:underline font-medium">hello@showcrate.test</a>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-card border border-border flex items-center justify-center shrink-0 text-primary shadow-sm">
                <MapPin className="w-6 h-6" />
              </div>
              <div>
                <h3 class="text-lg font-bold text-foreground mb-1">Visit us</h3>
                <p class="text-muted-foreground mb-1">Come say hello at our office HQ.</p>
                <span class="text-foreground font-medium">100 Documentation Way, San Francisco, CA 94107</span>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-card border border-border flex items-center justify-center shrink-0 text-primary shadow-sm">
                <Phone className="w-6 h-6" />
              </div>
              <div>
                <h3 class="text-lg font-bold text-foreground mb-1">Call us</h3>
                <p class="text-muted-foreground mb-1">Mon-Fri from 8am to 5pm PST.</p>
                <a href="tel:+15550000000" class="text-primary hover:underline font-medium">+1 (555) 000-0000</a>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Right Side: Form -->
        <div class="relative">
          <div class="absolute inset-0 bg-primary/5 rounded-3xl translate-x-4 translate-y-4"></div>
          <div class="relative bg-card/80 backdrop-blur-xl border border-border/50 rounded-3xl p-8 sm:p-10 shadow-2xl">
            <ContactForm client:load />
          </div>
        </div>

      </div>
    </div>
  </div>
</LandingLayout>
