---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { GradientHeading } from "@/components/public/GradientHeading";
import { ContactForm } from "@/components/public/ContactForm";
---

<PublicLayout title="Contact Us | Showcrate">
  <div class="relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[600px] bg-primary/20 blur-[150px] rounded-full -z-10 pointer-events-none"></div>

    <div class="container mx-auto px-4 py-24 sm:px-6 lg:px-8">
      <div class="mb-16 text-center">
        <span class="text-primary font-semibold tracking-wider uppercase text-sm mb-2 block">Contact Us</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-foreground pb-2">
          We'd love to hear from you
        </h1>
      </div>

      <ContactForm client:load />
    </div>
  </div>
</PublicLayout>
