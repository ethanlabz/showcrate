---
import AppLayout from "@/layouts/AppLayout.astro";
import { createServerClient } from "@/lib/supabase/server";
import { ProjectRepository } from "@/lib/repositories/ProjectRepository";
import { Plus, Code2, Globe, Clock, Settings, Search, BookOpen, Star, Activity, ArrowRight } from "lucide-react";

if (!Astro.locals.user) {
  return Astro.redirect('/auth/login');
}

const db = createServerClient(Astro.cookies);
const projectRepo = new ProjectRepository(db);
const projects = await projectRepo.listByOwner(Astro.locals.user.id);
const user = Astro.locals.user;
---

<AppLayout title="Dashboard | Showcrate">
  <div class="max-w-[1280px] mx-auto w-full flex flex-col md:flex-row gap-8">
    
    {/* Left Sidebar (GitHub style) */}
    <aside class="w-full md:w-[320px] shrink-0 flex flex-col gap-6">
      {/* User Info */}
      <div class="flex items-center gap-3">
        <div class="h-10 w-10 rounded-full bg-primary/20 flex items-center justify-center text-primary font-bold overflow-hidden border border-border">
           {user.avatarUrl ? (
             <img src={user.avatarUrl} alt={user.username || 'User'} class="w-full h-full object-cover" />
           ) : (
             (user.username || user.email || '?')[0].toUpperCase()
           )}
        </div>
        <div class="flex flex-col">
          <span class="font-semibold text-foreground text-sm leading-tight">{user.username || 'Anonymous User'}</span>
          <span class="text-xs text-muted-foreground">{user.email}</span>
        </div>
      </div>

      <hr class="border-border/50" />

      {/* Top Projects */}
      <div class="flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold text-foreground">Top Projects</h2>
          <a href="/new" class="flex items-center gap-1 bg-success/10 text-success hover:bg-success/20 transition-colors px-2 py-1 rounded text-xs font-medium border border-success/20">
            <Plus class="w-3 h-3" /> New
          </a>
        </div>
        
        <div class="relative">
          <Search class="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-muted-foreground" />
          <input 
            type="text" 
            placeholder="Find a project..." 
            class="w-full bg-background border border-border rounded-md pl-8 pr-3 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-primary/50 transition-all placeholder:text-muted-foreground/70"
          />
        </div>

        <div class="flex flex-col gap-1 mt-1">
          {projects.slice(0, 5).map(project => (
            <a href={`/${user.username}/${project.slug}`} class="flex items-center gap-2 px-2 py-1.5 hover:bg-muted/50 rounded-md transition-colors text-sm group">
              {project.visibility === 'public' ? <BookOpen class="w-4 h-4 text-muted-foreground" /> : <Settings class="w-4 h-4 text-muted-foreground" />}
              <span class="font-medium text-primary group-hover:underline truncate">{user.username}/{project.name}</span>
            </a>
          ))}
          {projects.length === 0 && (
             <div class="text-xs text-muted-foreground italic px-2 py-1">No projects found.</div>
          )}
        </div>
        
        {projects.length > 5 && (
          <a href="/projects" class="text-xs text-muted-foreground hover:text-primary transition-colors mt-2 px-2">Show more...</a>
        )}
      </div>
    </aside>

    {/* Center Feed */}
    <div class="flex-1 flex flex-col gap-6">
      <div class="flex items-center justify-between border-b border-border/50 pb-4">
        <h1 class="text-xl font-semibold text-foreground">Recent Activity</h1>
      </div>

      {projects.length === 0 ? (
        <div class="border border-border rounded-xl p-8 flex flex-col items-center justify-center text-center bg-card/20 relative">
          <Code2 class="w-8 h-8 text-muted-foreground mb-4" />
          <h2 class="text-lg font-semibold mb-2">Welcome to your dashboard</h2>
          <p class="text-sm text-muted-foreground max-w-sm mb-6">
            Create your first interactive environment to get started. Choose from a template or start from scratch.
          </p>
          <a href="/new" class="bg-success text-success-foreground font-medium px-4 py-2 rounded-md hover:bg-success/90 transition-colors shadow-sm text-sm">
            Create a repository
          </a>
        </div>
      ) : (
        <div class="flex flex-col gap-4">
          {projects.map(project => (
            <div class="border border-border bg-card/30 rounded-xl p-5 flex flex-col sm:flex-row gap-4 justify-between items-start hover:border-primary/30 transition-colors">
              <div class="flex flex-col gap-1.5 flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <a href={`/${user.username}/${project.slug}`} class="text-primary font-semibold text-lg hover:underline truncate">
                    {project.name}
                  </a>
                  <span class="text-[10px] font-medium border border-border text-muted-foreground px-1.5 py-0.5 rounded-full uppercase tracking-wide">
                    {project.visibility}
                  </span>
                </div>
                <p class="text-sm text-muted-foreground line-clamp-2">
                  {project.tagline || 'No description, website, or topics provided.'}
                </p>
                <div class="flex items-center gap-4 mt-2 text-xs text-muted-foreground">
                  <div class="flex items-center gap-1">
                    <span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
                    <span>JavaScript</span>
                  </div>
                  <div class="flex items-center gap-1 hover:text-primary transition-colors cursor-pointer">
                    <Star class="w-3.5 h-3.5" />
                    <span>0</span>
                  </div>
                  <div>Updated {new Date(project.updated_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric' })}</div>
                </div>
              </div>
              
              <div class="shrink-0 flex items-center gap-2 border border-border rounded-md overflow-hidden bg-card/50">
                <button class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium hover:bg-muted transition-colors border-r border-border">
                  <Star class="w-3.5 h-3.5 text-muted-foreground" />
                  Star
                </button>
                <button class="px-2 py-1.5 hover:bg-muted transition-colors">
                  <ArrowRight class="w-3 h-3 text-muted-foreground" />
                </button>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    {/* Right Sidebar */}
    <aside class="hidden lg:flex w-[300px] shrink-0 flex-col gap-6">
      <div class="border border-border rounded-xl bg-card/20 p-4 flex flex-col gap-3">
        <h2 class="text-sm font-semibold flex items-center gap-2">
          <Activity class="w-4 h-4 text-muted-foreground" /> Explore Showcrate
        </h2>
        <p class="text-xs text-muted-foreground leading-relaxed">
          Discover interactive environments created by the community. See how others are using Showcrate for their documentation.
        </p>
        <a href="/showcase" class="text-xs font-medium text-primary hover:underline flex items-center gap-1">
          Explore Showcase <ArrowRight class="w-3 h-3" />
        </a>
      </div>

      <div class="border border-border rounded-xl bg-card/20 p-4 flex flex-col gap-3">
        <h2 class="text-sm font-semibold flex items-center gap-2">
          <Globe class="w-4 h-4 text-muted-foreground" /> Documentation
        </h2>
        <p class="text-xs text-muted-foreground leading-relaxed">
          Learn how to get the most out of Showcrate, set up custom domains, and configure your WebContainers.
        </p>
        <a href="/docs" class="text-xs font-medium text-primary hover:underline flex items-center gap-1">
          Read Docs <ArrowRight class="w-3 h-3" />
        </a>
      </div>
    </aside>

  </div>
</AppLayout>
