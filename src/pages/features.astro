---
import LandingLayout from "@/layouts/HomeLayout.astro";
import { BookOpen, Code2, Cpu, Globe, Layout, Shield, Zap } from "lucide-react";
import { Button } from "@/components/ui/Button";

const features = [
  {
    icon: Code2,
    title: "Interactive Playgrounds",
    description: "Write React, Vue, or Vanilla JS in your docs and let users play with the code live.",
    color: "text-blue-500",
    bg: "bg-blue-500/10"
  },
  {
    icon: Cpu,
    title: "WebContainers Inside",
    description: "Run Node.js directly inside the browser. No cloud VMs or cold starts. It just works.",
    color: "text-emerald-500",
    bg: "bg-emerald-500/10"
  },
  {
    icon: Layout,
    title: "MDX Support",
    description: "Seamlessly mix Markdown and JSX. Import your own components right into your documentation.",
    color: "text-purple-500",
    bg: "bg-purple-500/10"
  },
  {
    icon: Globe,
    title: "Custom Domains",
    description: "Publish your docs to a custom domain with automatic SSL and global CDN distribution.",
    color: "text-amber-500",
    bg: "bg-amber-500/10"
  },
  {
    icon: Zap,
    title: "Instant Updates",
    description: "Push changes to your repository and see them instantly deployed to your live documentation.",
    color: "text-red-500",
    bg: "bg-red-500/10"
  },
  {
    icon: Shield,
    title: "Built-in Analytics",
    description: "Understand how users interact with your docs without sacrificing their privacy.",
    color: "text-indigo-500",
    bg: "bg-indigo-500/10"
  }
];
---

<LandingLayout title="Features - Showcrate">
  <div class="relative min-h-screen pb-32 overflow-hidden">
    <!-- Abstract Background -->
    <div class="absolute top-0 right-0 w-1/2 h-[500px] bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-primary/20 via-transparent to-transparent pointer-events-none"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:48px_48px] pointer-events-none"></div>
    
    <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8 pt-32 lg:pt-40 mb-24 max-w-4xl text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 border border-primary/20 text-primary text-sm font-bold tracking-wider uppercase mb-6 shadow-sm">
        <Zap className="w-4 h-4 fill-primary/20" /> Powerful Features
      </div>
      <h1 class="text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tight mb-8 bg-clip-text text-transparent bg-gradient-to-b from-foreground to-foreground/60 text-balance">
        Everything you need. Nothing you don't.
      </h1>
      <p class="text-xl sm:text-2xl text-muted-foreground leading-relaxed max-w-2xl mx-auto">
        Showcrate provides a complete toolset for building state-of-the-art interactive documentation out of the box.
      </p>
    </div>

    <!-- Feature Grid -->
    <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {features.map((feature) => {
          const Icon = feature.icon;
          return (
            <div class="group relative rounded-3xl border border-border/50 bg-card/40 backdrop-blur-md overflow-hidden hover:border-primary/50 transition-colors duration-500">
              <!-- Glow -->
              <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              
              <div class="p-8 sm:p-10 relative z-10">
                <div class={`w-14 h-14 rounded-2xl flex items-center justify-center mb-8 border border-background shadow-sm ${feature.bg}`}>
                  <Icon className={`w-7 h-7 ${feature.color}`} />
                </div>
                
                <h3 class="text-2xl font-bold mb-4 text-foreground tracking-tight">{feature.title}</h3>
                <p class="text-muted-foreground leading-relaxed">
                  {feature.description}
                </p>
              </div>
            </div>
          );
        })}
      </div>
      
      <!-- Deep Dive Section -->
      <div class="mt-32 rounded-[2.5rem] bg-foreground text-background overflow-hidden relative">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_var(--tw-gradient-stops))] from-primary/40 via-transparent to-transparent opacity-50"></div>
        <div class="p-12 sm:p-20 relative z-10 flex flex-col md:flex-row items-center gap-12 lg:gap-20">
          <div class="flex-1 text-center md:text-left">
            <h2 class="text-4xl md:text-5xl font-extrabold mb-6 tracking-tight">Ready to see it in action?</h2>
            <p class="text-xl opacity-80 mb-8 max-w-lg">Read the comprehensive guide on building your first interactive component.</p>
            <Button size="lg" className="rounded-full h-14 px-8 text-lg font-bold bg-background text-foreground hover:bg-background/90 hover:scale-105 transition-all">
              <BookOpen className="w-5 h-5 mr-2" /> Read the Guide
            </Button>
          </div>
          
          <div class="flex-1 w-full relative">
            <!-- Brutalist Decorative Element -->
            <div class="absolute inset-0 translate-x-4 translate-y-4 bg-primary rounded-xl z-0"></div>
            <div class="relative z-10 border-2 border-background/20 rounded-xl overflow-hidden bg-[#0d1117] p-6 shadow-2xl">
              <div class="flex gap-2 mb-4">
                <div class="w-3 h-3 rounded-full bg-red-500"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                <div class="w-3 h-3 rounded-full bg-green-500"></div>
              </div>
              <pre class="font-mono text-sm text-[#c9d1d9] overflow-x-auto"><code><span class="text-[#ff7b72]">import</span> &#123; createDocs &#125; <span class="text-[#ff7b72]">from</span> <span class="text-[#a5d6ff]">'showcrate'</span>;

<span class="text-[#ff7b72]">export default</span> createDocs(&#123;
  theme: <span class="text-[#a5d6ff]">'dark'</span>,
  interactive: <span class="text-[#79c0ff]">true</span>
&#125;);</code></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</LandingLayout>
