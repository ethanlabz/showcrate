---
import HomeLayout from '@/layouts/HomeLayout.astro';
import ScrollReveal from '@/components/animations/ScrollReveal';
import {
  AlsoIncluded,
  FeatureGrid,
} from '@/components/pages/home/features/FeaturesSections';
// Reused from the About page: same closing call to action.
import { ClosingCta } from '@/components/pages/home/about/AboutSections';

// Hydrate just before scrolling into view so reveals are ready on arrival.
const early = { rootMargin: '200px' };
---

<HomeLayout title='Features'>
  <div class='relative overflow-hidden'>
    <!-- Background: soft glow + faint grid -->
    <ScrollReveal
      direction='none'
      duration={1.2}
      aria-hidden='true'
      client:load
      className='pointer-events-none absolute inset-x-0 top-0 h-136 bg-linear-to-b from-primary/10 to-transparent'
    />
    <div
      aria-hidden='true'
      class='pointer-events-none absolute inset-x-0 top-0 h-176 bg-[linear-gradient(to_right,#80808010_1px,transparent_1px),linear-gradient(to_bottom,#80808010_1px,transparent_1px)] bg-size-[48px_48px] mask-[linear-gradient(to_bottom,black,transparent)]'
    >
    </div>

    <!-- Hero -->
    <section
      class='relative mx-auto max-w-5xl px-4 pt-32 pb-20 sm:px-6 lg:px-8 lg:pt-44 lg:pb-28'
    >
      <ScrollReveal as='p' delay={0.1} client:load
        className='mb-6 text-sm font-medium uppercase tracking-[0.2em] text-primary'
      >
        Features
      </ScrollReveal>
      <ScrollReveal as='h1' delay={0.25} client:load
        className='max-w-4xl text-5xl font-semibold leading-[1.05] tracking-tight text-foreground text-balance sm:text-6xl md:text-7xl'
      >
        Everything a project write-up needs. <span class='text-primary'>Nothing it doesn't.</span>
      </ScrollReveal>
      <ScrollReveal as='p' delay={0.4} client:load
        className='mt-8 max-w-2xl text-lg leading-relaxed text-muted-foreground text-pretty sm:text-xl'
      >
        Write in blocks, organise pages like files, and publish to a public
        showcase. Here is what is in the first release.
      </ScrollReveal>
    </section>

    <!-- Core features -->
    <section
      aria-labelledby='core-heading'
      class='relative mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8 lg:pb-32'
    >
      <ScrollReveal as='h2' id='core-heading' client:visible={early}
        className='sr-only'
      >
        Core features
      </ScrollReveal>
      <FeatureGrid client:visible={early} />
    </section>

    <!-- Also included -->
    <section
      aria-labelledby='also-heading'
      class='border-y border-border bg-card/40'
    >
      <div class='mx-auto max-w-5xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32'>
        <ScrollReveal as='h2' id='also-heading' client:visible={early}
          className='mb-12 max-w-2xl text-3xl font-semibold tracking-tight text-foreground sm:text-4xl'
        >
          And the pieces around it.
        </ScrollReveal>
        <AlsoIncluded client:visible={early} />
      </div>
    </section>

    <!-- Closing CTA -->
    <section
      aria-labelledby='cta-heading'
      class='mx-auto max-w-5xl px-4 py-32 text-center sm:px-6 lg:px-8'
    >
      <ClosingCta client:visible={early} />
    </section>
  </div>
</HomeLayout>