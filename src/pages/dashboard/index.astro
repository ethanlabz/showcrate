---
import AppLayout from '@/layouts/AppLayout.astro';
import { createServerClient } from '@/lib/supabase/server';
import { Plus, FolderKanban, ExternalLink, Settings, FileCode2, Users } from 'lucide-react';
import { Button } from '@/components/ui/button';

const viewer = Astro.locals.viewer ?? Astro.locals.user;
if (!viewer) {
  return Astro.redirect('/auth/login?next=%2Fdashboard');
}

const supabase = createServerClient(Astro.cookies);

// 1. Owned projects
const { data: ownedProjects, error: ownedError } = await supabase
  .from('projects')
  .select('id, name, slug, tagline, visibility, published, updated_at')
  .eq('owner_id', viewer.id)
  .is('deleted_at', null)
  .order('updated_at', { ascending: false });

if (ownedError) {
  console.error('[Dashboard] Error fetching owned projects:', ownedError);
}

// 2. Credited on (accepted collaborator invites, read-only)
const { data: collaborations, error: collabError } = await supabase
  .from('project_collaborators')
  .select(`
    id,
    display_role,
    accepted_at,
    project:project_id (
      id,
      name,
      slug,
      tagline,
      visibility,
      published,
      deleted_at,
      owner:owner_id ( username )
    )
  `)
  .eq('user_id', viewer.id)
  .not('accepted_at', 'is', null);

if (collabError) {
  console.error('[Dashboard] Error fetching collaborations:', collabError);
}

// Filter out deleted projects if any
const creditedProjects = (collaborations || [])
  .filter((c: any) => c.project && !c.project.deleted_at);
---

<AppLayout
  title="Projects"
  iconName="projects"
  headerTitle="Your Projects"
  headerDescription="Manage documentation projects you own or collaborate on."
  maxWidth="max-w-5xl"
>
  <div class="space-y-10">
    <!-- Section: Your projects -->
    <div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-heading text-lg font-semibold text-foreground flex items-center gap-2">
          <span>Owned projects</span>
          <span class="text-xs font-mono font-normal text-muted-foreground px-2 py-0.5 rounded-full bg-surface-raised border border-border/40">
            {ownedProjects?.length ?? 0}
          </span>
        </h2>
        <a href="/dashboard/new">
          <Button size="sm" className="bg-accent text-accent-foreground hover:bg-accent-hover font-medium">
            <Plus className="h-4 w-4 mr-1.5" />
            New project
          </Button>
        </a>
      </div>

      {ownedProjects && ownedProjects.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {ownedProjects.map((p: any) => (
            <div class="rounded-xl border border-border/50 bg-surface/50 p-5 hover:border-accent/40 transition-colors flex flex-col justify-between">
              <div>
                <div class="flex items-start justify-between gap-2 mb-2">
                  <h3 class="font-heading font-bold text-base text-foreground truncate">
                    {p.name}
                  </h3>
                  <div class="flex items-center gap-1.5 shrink-0">
                    <span class={`text-[10px] uppercase font-mono px-2 py-0.5 rounded border ${
                      p.published
                        ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-400'
                        : 'border-amber-500/30 bg-amber-500/10 text-amber-400'
                    }`}>
                      {p.published ? 'Published' : 'Draft'}
                    </span>
                    <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded border border-border/60 bg-surface text-muted-foreground">
                      {p.visibility}
                    </span>
                  </div>
                </div>

                {p.tagline && (
                  <p class="text-xs text-muted-foreground line-clamp-2 mb-4">
                    {p.tagline}
                  </p>
                )}
              </div>

              <div class="pt-4 border-t border-border/40 flex items-center justify-between mt-auto text-xs">
                <div class="flex items-center gap-2">
                  <a
                    href={`/editor/${p.id}`}
                    class="flex items-center gap-1 text-accent hover:underline font-medium"
                  >
                    <FileCode2 className="h-3.5 w-3.5" />
                    Editor
                  </a>
                  <span class="text-muted-foreground/40">•</span>
                  <a
                    href={`/dashboard/projects/${p.id}/settings/general`}
                    class="flex items-center gap-1 text-muted-foreground hover:text-foreground"
                  >
                    <Settings className="h-3.5 w-3.5" />
                    Settings
                  </a>
                </div>

                {p.published && viewer.username && (
                  <a
                    href={`/${viewer.username}/${p.slug}`}
                    target="_blank"
                    rel="noreferrer"
                    class="flex items-center gap-1 text-muted-foreground hover:text-accent"
                  >
                    <span>View</span>
                    <ExternalLink className="h-3 w-3" />
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="rounded-xl border border-dashed border-border/60 p-8 text-center bg-surface/20">
          <FolderKanban className="h-10 w-10 text-muted-foreground/50 mx-auto mb-3" />
          <h3 class="font-heading font-semibold text-foreground text-base mb-1">
            No projects yet
          </h3>
          <p class="text-xs text-muted-foreground max-w-sm mx-auto mb-4">
            Create your first documentation project to start drafting interactive stages for your code.
          </p>
          <a href="/dashboard/new">
            <Button size="sm" className="bg-accent text-accent-foreground hover:bg-accent-hover font-medium">
              <Plus className="h-4 w-4 mr-1.5" />
              Create project
            </Button>
          </a>
        </div>
      )}
    </div>

    <!-- Section: Credited on -->
    <div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-heading text-lg font-semibold text-foreground flex items-center gap-2">
          <Users className="h-4 w-4 text-muted-foreground" />
          <span>Credited on</span>
          <span class="text-xs font-mono font-normal text-muted-foreground px-2 py-0.5 rounded-full bg-surface-raised border border-border/40">
            {creditedProjects.length}
          </span>
        </h2>
      </div>

      {creditedProjects.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {creditedProjects.map((c: any) => {
            const project = c.project;
            const ownerUsername = project.owner?.username;
            const publicUrl = `/${ownerUsername}/${project.slug}`;
            return (
              <div class="rounded-xl border border-border/40 bg-surface/30 p-4 flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between gap-2 mb-1.5">
                    <h3 class="font-heading font-bold text-sm text-foreground truncate">
                      {project.name}
                    </h3>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-surface-raised text-accent border border-border/40 shrink-0">
                      {c.display_role || 'Contributor'}
                    </span>
                  </div>
                  <p class="text-xs text-muted-foreground mb-3">
                    by @{ownerUsername}
                  </p>
                </div>

                <div class="pt-3 border-t border-border/40 flex items-center justify-between text-xs">
                  <span class="text-muted-foreground/60 text-[11px]">
                    Read-only access
                  </span>
                  <a
                    href={publicUrl}
                    class="flex items-center gap-1 text-accent hover:underline font-medium"
                  >
                    <span>View public page</span>
                    <ExternalLink className="h-3 w-3" />
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="rounded-xl border border-border/30 p-6 text-center bg-surface/10 text-xs text-muted-foreground">
          You haven't been credited on any other projects yet.
        </div>
      )}
    </div>
  </div>
</AppLayout>
