---
import AppLayout from '@/layouts/AppLayout.astro';
import { createServerClient } from '@/lib/supabase/server';
import { Plus, FolderKanban, ExternalLink, Users, LayoutGrid, Rows3, List, Download } from 'lucide-react';
import { Button } from '@/components/ui/button';

const viewer = Astro.locals.viewer ?? Astro.locals.user;
if (!viewer) {
  return Astro.redirect('/auth/login?next=%2Fdashboard');
}

const supabase = createServerClient(Astro.cookies);

// 1. Owned projects
const { data: ownedProjects, error: ownedError } = await supabase
  .from('projects')
  .select('id, name, slug, tagline, visibility, published, updated_at')
  .eq('owner_id', viewer.id)
  .is('deleted_at', null)
  .order('updated_at', { ascending: false });

if (ownedError) {
  console.error('[Dashboard] Error fetching owned projects:', ownedError);
}

// 2. Credited on (accepted collaborator invites, read-only)
const { data: collaborations, error: collabError } = await supabase
  .from('project_collaborators')
  .select(`
    id,
    display_role,
    accepted_at,
    project:project_id (
      id,
      name,
      slug,
      tagline,
      visibility,
      published,
      deleted_at,
      owner:owner_id ( username )
    )
  `)
  .eq('user_id', viewer.id)
  .not('accepted_at', 'is', null);

if (collabError) {
  console.error('[Dashboard] Error fetching collaborations:', collabError);
}

// Filter out deleted projects if any
const creditedProjects = (collaborations || [])
  .filter((c: any) => c.project && !c.project.deleted_at);

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
    + ' at '
    + d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
}
---

<AppLayout
  title="Projects"
  hideContentHeader={true}
  maxWidth="max-w-full"
>
  <!-- Page header: icon + title on left, action buttons on right -->
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-2.5">
      <FolderKanban className="h-5 w-5 text-foreground/80" />
      <h1 class="font-heading text-xl font-bold tracking-tight text-foreground">
        Projects
      </h1>
    </div>
    <div class="flex items-center gap-2">
      <a href="/dashboard/new">
        <Button size="sm" variant="outline" className="text-xs font-medium h-8 gap-1.5 cursor-pointer">
          <Plus className="h-3.5 w-3.5" />
          Create
        </Button>
      </a>
    </div>
  </div>

  <!-- Toolbar: Sort by, Filter by, View toggle -->
  <div class="flex flex-wrap items-center justify-between mb-6 gap-3">
    <div class="flex items-center gap-4 text-xs">
      <div class="flex items-center gap-2 text-muted-foreground">
        <span>Sort by</span>
        <span class="bg-accent/10 text-accent rounded-md px-3 py-1.5 text-xs font-medium cursor-default">
          Last Updated
        </span>
      </div>
      <div class="flex items-center gap-2 text-muted-foreground">
        <span>Filter by</span>
        <span class="bg-surface border border-border/60 rounded-md px-3 py-1.5 text-xs text-muted-foreground cursor-default">
          All
        </span>
      </div>
    </div>

    <div class="hidden sm:flex items-center border border-border/60 rounded-lg overflow-hidden text-xs">
      <button class="flex items-center gap-1.5 px-3 py-1.5 bg-surface-raised text-foreground cursor-default">
        <LayoutGrid className="h-3.5 w-3.5" />
        <span>Grid</span>
      </button>
      <button class="flex items-center gap-1.5 px-3 py-1.5 text-muted-foreground hover:text-foreground border-l border-border/60 transition-colors cursor-default">
        <Rows3 className="h-3.5 w-3.5" />
        <span>Compact</span>
      </button>
      <button class="flex items-center gap-1.5 px-3 py-1.5 text-muted-foreground hover:text-foreground border-l border-border/60 transition-colors cursor-default">
        <List className="h-3.5 w-3.5" />
        <span>List</span>
      </button>
    </div>
  </div>

  <!-- Project cards grid -->
  {ownedProjects && ownedProjects.length > 0 ? (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      {ownedProjects.map((p: any) => (
        <a href={`/dashboard/projects/${p.id}/settings/general`} class="group block">
          <div class="relative rounded-lg overflow-hidden border border-border/30 hover:border-border/60 transition-all duration-200 aspect-[3/4] bg-surface-raised/50">
            <!-- Document preview placeholder -->
            <div class="absolute inset-3 rounded bg-white/[0.03] border border-white/[0.04] p-4 flex flex-col gap-2.5 overflow-hidden">
              <!-- Title line -->
              <div class="h-3 w-3/5 rounded-sm bg-foreground/10"></div>
              <div class="h-0.5"></div>
              <!-- Body lines -->
              <div class="h-2 w-full rounded-sm bg-foreground/[0.06]"></div>
              <div class="h-2 w-11/12 rounded-sm bg-foreground/[0.06]"></div>
              <div class="h-2 w-full rounded-sm bg-foreground/[0.06]"></div>
              <div class="h-2 w-4/5 rounded-sm bg-foreground/[0.06]"></div>
              <div class="h-2 w-full rounded-sm bg-foreground/[0.06]"></div>
              <div class="h-2 w-2/3 rounded-sm bg-foreground/[0.06]"></div>
              <div class="h-3"></div>
              <!-- Sub-heading -->
              <div class="h-2.5 w-2/5 rounded-sm bg-foreground/[0.08]"></div>
              <div class="h-2 w-full rounded-sm bg-foreground/[0.06]"></div>
              <div class="h-2 w-5/6 rounded-sm bg-foreground/[0.06]"></div>
              <div class="h-2 w-full rounded-sm bg-foreground/[0.06]"></div>
              <div class="h-2 w-3/4 rounded-sm bg-foreground/[0.06]"></div>
            </div>

            <!-- Bottom gradient overlay with name + date -->
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-4 pt-12">
              <h3 class="font-heading font-bold text-sm text-white truncate">
                {p.name}
              </h3>
              <p class="text-[11px] text-white/50 mt-0.5 truncate">
                Last updated on {formatDate(p.updated_at)}
              </p>
            </div>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="rounded-xl border border-dashed border-border/60 p-12 text-center bg-surface/20">
      <FolderKanban className="h-10 w-10 text-muted-foreground/40 mx-auto mb-3" />
      <h3 class="font-heading font-semibold text-foreground text-base mb-1">
        No projects yet
      </h3>
      <p class="text-xs text-muted-foreground max-w-sm mx-auto mb-4">
        Create your first documentation project to get started.
      </p>
      <a href="/dashboard/new">
        <Button size="sm" className="bg-accent text-accent-foreground hover:bg-accent-hover font-medium">
          <Plus className="h-4 w-4 mr-1.5" />
          Create project
        </Button>
      </a>
    </div>
  )}

  <!-- Section: Credited on -->
  {creditedProjects.length > 0 && (
    <div class="mt-12">
      <div class="flex items-center gap-2.5 mb-6">
        <Users className="h-5 w-5 text-foreground/80" />
        <h2 class="font-heading text-xl font-bold tracking-tight text-foreground">
          Credited on
        </h2>
        <span class="text-xs font-mono text-muted-foreground px-2 py-0.5 rounded-full bg-surface-raised border border-border/40">
          {creditedProjects.length}
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {creditedProjects.map((c: any) => {
          const project = c.project;
          const ownerUsername = project.owner?.username;
          const publicUrl = `/${ownerUsername}/${project.slug}`;
          return (
            <a href={publicUrl} target="_blank" rel="noreferrer" class="group block">
              <div class="relative rounded-lg overflow-hidden border border-border/30 hover:border-border/60 transition-all duration-200 aspect-[3/4] bg-surface/30">
                <!-- Document preview placeholder (dimmer for credited) -->
                <div class="absolute inset-3 rounded bg-white/[0.02] border border-white/[0.03] p-4 flex flex-col gap-2.5 overflow-hidden">
                  <div class="h-3 w-3/5 rounded-sm bg-foreground/[0.07]"></div>
                  <div class="h-0.5"></div>
                  <div class="h-2 w-full rounded-sm bg-foreground/[0.04]"></div>
                  <div class="h-2 w-5/6 rounded-sm bg-foreground/[0.04]"></div>
                  <div class="h-2 w-full rounded-sm bg-foreground/[0.04]"></div>
                  <div class="h-2 w-2/3 rounded-sm bg-foreground/[0.04]"></div>
                </div>

                <!-- Bottom gradient overlay -->
                <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-4 pt-12">
                  <h3 class="font-heading font-bold text-sm text-white truncate">
                    {project.name}
                  </h3>
                  <p class="text-[11px] text-white/50 mt-0.5 truncate">
                    by @{ownerUsername} · {c.display_role || 'Contributor'}
                  </p>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  )}
</AppLayout>
