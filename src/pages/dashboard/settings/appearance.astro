---
import AppLayout from '@/layouts/AppLayout.astro';
import { ThemeToggle } from '@/components/ui/theme-toggle';
import { SunMoon } from 'lucide-react';

const viewer = Astro.locals.viewer ?? Astro.locals.user;
if (!viewer) {
  return Astro.redirect('/auth/login?next=%2Fdashboard%2Fsettings%2Fappearance');
}
---

<AppLayout
  title="Appearance Settings"
  iconName="appearance"
  headerTitle="Appearance"
  headerDescription="Customize the look and theme of your Showcrate workspace."
  maxWidth="max-w-[720px]"
>
  <div class="rounded-xl border border-border/50 bg-surface/30 p-6 sm:p-8 space-y-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 class="text-sm font-semibold text-foreground flex items-center gap-2">
          <SunMoon className="h-4 w-4 text-[#C9A96A]" />
          <span>Interface Theme</span>
        </h3>
        <p class="text-xs text-muted-foreground mt-1 max-w-md">
          Showcrate is styled with a dark stage aesthetic by default. Toggle between dark and light modes.
        </p>
      </div>

      <div class="shrink-0">
        <ThemeToggle client:load />
      </div>
    </div>

    <div class="pt-6 border-t border-border/40">
      <h4 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">
        Typography & Design Tokens
      </h4>
      <p class="text-xs text-muted-foreground">
        Showcrate uses <strong class="text-foreground">Fraunces</strong> for editorial display headings and <strong class="text-foreground">Outfit</strong> for interface elements with warm gold accents.
      </p>
    </div>
  </div>
</AppLayout>
