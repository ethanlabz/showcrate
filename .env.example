# Copy this file to .env and fill in your real Supabase project values
# Get Supabase values from: https://supabase.com/dashboard/project/_/settings/api

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1...

# ── Site ────────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:4321
NODE_ENV=production

# ── Email (Resend - optional in dev) ─────────────────────────────────────────
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=YOUR_FROM_MAIL
