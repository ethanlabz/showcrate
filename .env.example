# ============================================================
# Showcrate — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Supabase ---
# Public URL of your Supabase project
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key — safe to use in browser/client
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — SERVER ONLY. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Site ---
# Full URL of the deployed site (no trailing slash)
SITE_URL=http://localhost:4321

# --- Resend (Email) ---
RESEND_API_KEY=re_your-api-key-here

# Email address used as the "from" sender
RESEND_FROM_EMAIL=noreply@showcrate.io

# --- Sentry (Error Tracking) ---
# Leave empty to disable Sentry in development
SENTRY_DSN=https://your-key@sentry.io/your-project-id

# --- App ---
NODE_ENV=development
